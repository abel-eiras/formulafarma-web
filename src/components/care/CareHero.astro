---
import { ArrowRight, HeartPulse, Sparkles, Users, Shield } from 'lucide-astro';
import Button from '@/components/ui/Button.astro';
---

<section class="relative min-h-screen flex items-center pt-20 overflow-hidden bg-background">
  <!-- Grid -->
  <div class="absolute inset-0 z-0 opacity-[0.04]">
    <div 
      class="absolute inset-0" 
      style="background-image: repeating-linear-gradient(0deg, hsl(0 0% 5%) 0px, hsl(0 0% 5%) 1px, transparent 1px, transparent 80px), repeating-linear-gradient(90deg, hsl(0 0% 5%) 0px, hsl(0 0% 5%) 1px, transparent 1px, transparent 80px);"
    />
  </div>

  <div class="absolute top-32 right-12 w-40 h-40 bg-primary rotate-12 hidden lg:block" />
  <div class="absolute bottom-40 left-8 w-24 h-24 bg-accent -rotate-6 hidden lg:block" />

  <div class="container mx-auto px-4 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div class="max-w-2xl">
        <div class="animate-fade-up" style="animation-delay: 0s;">
          <div class="inline-block px-4 py-2 bg-foreground text-background font-body text-xs font-bold uppercase tracking-widest mb-6">
            Beta Abierta — Construyéndolo contigo
          </div>
        </div>

        <div class="animate-fade-up" style="animation-delay: 0.1s;">
          <h1 class="font-display text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-bold text-foreground leading-[0.95] mb-6">
            Adiós Excel.{" "}
            <span class="text-primary italic">Hola cordura.</span>
          </h1>
        </div>

        <div class="animate-fade-up" style="animation-delay: 0.2s;">
          <p class="font-body text-base md:text-lg text-muted-foreground mb-4 leading-relaxed">
            Asesoramiento dermocosmético, parámetros bioquímicos, fichas de paciente...{" "}
            <strong class="text-foreground">Todo en un sitio. Todo bonito. Todo fácil.</strong>
          </p>
        </div>

        <div class="animate-fade-up" style="animation-delay: 0.25s;">
          <p class="font-body text-base text-muted-foreground mb-8">
            El software de servicios asistenciales que NO te venderá tu proveedor de siempre.{" "}
            <span class="text-primary font-medium">Y tú puedes ser de los primeros en probarlo.</span>
          </p>
        </div>

        <div class="animate-fade-up" style="animation-delay: 0.3s;">
          <div class="flex flex-col sm:flex-row gap-4 mb-12">
            <Button variant="hero" size="xl" href="https://formula-care.vercel.app/" target="_blank" rel="noopener">
              Probar Fórmula Care
              <ArrowRight class="w-5 h-5" />
            </Button>
            <Button variant="outline" size="xl" href="#cta">
              <HeartPulse class="w-5 h-5" />
              Solicitar Acceso
            </Button>
          </div>
        </div>

        <div class="animate-fade-up flex flex-wrap gap-6" style="animation-delay: 0.4s;">
          <div class="flex items-center gap-2 text-muted-foreground">
            <Shield class="w-5 h-5 text-primary" />
            <span class="text-sm font-medium">Acceso gratuito en beta</span>
          </div>
          <div class="flex items-center gap-2 text-muted-foreground">
            <Users class="w-5 h-5 text-primary" />
            <span class="text-sm font-medium">Feedback directo</span>
          </div>
          <div class="flex items-center gap-2 text-muted-foreground">
            <Sparkles class="w-5 h-5 text-primary" />
            <span class="text-sm font-medium">Ventajas exclusivas</span>
          </div>
        </div>
      </div>

      <div class="hidden lg:block">
        <div class="relative">
          <div class="brutal-border-thick bg-foreground p-8">
            <div class="border-4 border-background/30 p-6 space-y-6">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-primary flex items-center justify-center">
                  <HeartPulse class="w-6 h-6 text-primary-foreground" />
                </div>
                <div>
                  <p class="font-display font-bold text-background text-lg">Fórmula Care</p>
                  <p class="text-xs text-background/50 font-body uppercase tracking-widest">Panel de control</p>
                </div>
              </div>
              <div class="space-y-2">
                <div class="h-3 bg-background/20 w-full" />
                <div class="h-3 bg-background/20 w-4/5" />
                <div class="h-3 bg-background/15 w-3/5" />
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div class="border-2 border-background/30 p-4">
                  <p class="text-xs text-background/50 font-body uppercase">Pacientes</p>
                  <p class="font-display font-bold text-3xl text-accent">127</p>
                </div>
                <div class="border-2 border-background/30 p-4">
                  <p class="text-xs text-background/50 font-body uppercase">Consultas</p>
                  <p class="font-display font-bold text-3xl text-accent">342</p>
                </div>
              </div>
            </div>
          </div>
          <div class="absolute -bottom-4 -left-4 brutal-border bg-card p-4 shadow-elevated">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-foreground flex items-center justify-center">
                <HeartPulse class="w-5 h-5 text-background" />
              </div>
              <div>
                <div class="font-display text-xl font-bold text-foreground">Beta</div>
                <p class="text-xs text-muted-foreground">Únete a los pioneros</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 right-0 h-1 bg-foreground" />
</section>
