---
import { ArrowRight, HeartPulse, Sparkles, Users, Shield } from 'lucide-astro';
import Button from '@/components/ui/Button.astro';
---

<section class="relative min-h-screen flex items-center pt-20 overflow-hidden bg-gradient-mesh">
  <!-- Background Elements -->
  <div class="absolute inset-0 z-0">
    <div class="absolute top-20 right-20 w-96 h-96 bg-primary/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 left-20 w-80 h-80 bg-accent/5 rounded-full blur-3xl"></div>
  </div>

  <div class="container mx-auto px-4 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Content -->
      <div class="max-w-2xl">
        <div class="animate-fade-up" style="animation-delay: 0s;">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-accent/20 border border-accent/30 mb-6">
            <Sparkles class="w-4 h-4 text-accent" />
            <span class="text-sm font-semibold text-accent">
              Beta Abierta — Construyéndolo contigo
            </span>
          </div>
        </div>

        <div class="animate-fade-up" style="animation-delay: 0.1s;">
          <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-foreground leading-tight mb-6">
            Adiós Excel.{" "}
            <span class="text-gradient-primary">Hola cordura.</span>
          </h1>
        </div>

        <div class="animate-fade-up" style="animation-delay: 0.2s;">
          <p class="font-body text-lg md:text-xl text-muted-foreground mb-4 leading-relaxed">
            Asesoramiento dermocosmético, parámetros bioquímicos, fichas de paciente...{" "}
            <strong class="text-foreground">Todo en un sitio. Todo bonito. Todo fácil.</strong>
          </p>
        </div>

        <div class="animate-fade-up" style="animation-delay: 0.25s;">
          <p class="font-body text-base text-muted-foreground mb-8">
            El software de servicios asistenciales que NO te venderá tu proveedor de siempre.{" "}
            <span class="text-primary font-medium">Y tú puedes ser de los primeros en probarlo.</span>
          </p>
        </div>

        <div class="animate-fade-up" style="animation-delay: 0.3s;">
          <div class="flex flex-col sm:flex-row gap-4 mb-12">
            <Button variant="hero" size="xl" href="#cta">
              Solicitar Acceso Beta
              <ArrowRight class="w-5 h-5" />
            </Button>
            <Button variant="outline" size="xl" href="#funcionalidades">
              <HeartPulse class="w-5 h-5" />
              Conocer Más
            </Button>
          </div>
        </div>

        <!-- Trust Badges -->
        <div class="animate-fade-up flex flex-wrap gap-6" style="animation-delay: 0.4s;">
          <div class="flex items-center gap-2 text-muted-foreground">
            <Shield class="w-5 h-5 text-primary" />
            <span class="text-sm font-medium">Acceso gratuito en beta</span>
          </div>
          <div class="flex items-center gap-2 text-muted-foreground">
            <Users class="w-5 h-5 text-primary" />
            <span class="text-sm font-medium">Feedback directo</span>
          </div>
          <div class="flex items-center gap-2 text-muted-foreground">
            <Sparkles class="w-5 h-5 text-primary" />
            <span class="text-sm font-medium">Ventajas exclusivas</span>
          </div>
        </div>
      </div>

      <!-- Hero Visual -->
      <div class="hidden lg:block">
        <div class="relative">
          <div class="absolute -top-4 -left-4 w-24 h-24 bg-accent/20 rounded-full blur-3xl"></div>
          <div class="absolute -bottom-8 -right-8 w-32 h-32 bg-primary/20 rounded-full blur-3xl"></div>
          
          <div class="relative rounded-2xl overflow-hidden shadow-elevated border border-border bg-gradient-hero p-8">
            <div class="bg-card/10 backdrop-blur rounded-xl p-6 space-y-4">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 rounded-xl bg-primary-foreground/20 flex items-center justify-center">
                  <HeartPulse class="w-6 h-6 text-primary-foreground" />
                </div>
                <div>
                  <p class="font-display font-bold text-primary-foreground">Fórmula Care</p>
                  <p class="text-sm text-primary-foreground/70">Panel de control</p>
                </div>
              </div>
              
              <div class="space-y-3">
                <div class="h-3 bg-primary-foreground/20 rounded-full w-full"></div>
                <div class="h-3 bg-primary-foreground/20 rounded-full w-4/5"></div>
                <div class="h-3 bg-primary-foreground/20 rounded-full w-3/5"></div>
              </div>

              <div class="grid grid-cols-2 gap-3 mt-6">
                <div class="bg-primary-foreground/10 rounded-lg p-3">
                  <p class="text-xs text-primary-foreground/70">Pacientes</p>
                  <p class="font-display font-bold text-xl text-primary-foreground">127</p>
                </div>
                <div class="bg-primary-foreground/10 rounded-lg p-3">
                  <p class="text-xs text-primary-foreground/70">Consultas</p>
                  <p class="font-display font-bold text-xl text-primary-foreground">342</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Floating Beta Card -->
          <div class="absolute -bottom-6 -left-6 bg-card/95 backdrop-blur-lg rounded-xl p-4 shadow-elevated border border-border">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-gradient-hero flex items-center justify-center">
                <HeartPulse class="w-5 h-5 text-primary-foreground" />
              </div>
              <div>
                <div class="font-display text-xl font-bold text-foreground">Beta</div>
                <p class="text-xs text-muted-foreground">Únete a los pioneros</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Wave -->
  <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-secondary to-transparent"></div>
</section>
