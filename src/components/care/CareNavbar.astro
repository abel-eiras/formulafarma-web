---
import { Beaker, Menu, X } from 'lucide-astro';
import Button from '@/components/ui/Button.astro';

const navItems = [
  { label: 'Funcionalidades', href: '#funcionalidades' },
  { label: 'Cómo Funciona', href: '#como-funciona' },
  { label: 'Nosotros', href: '#nosotros' },
  { label: 'Beta', href: '#beta' },
];
---

<nav id="care-navbar" class="fixed top-0 left-0 right-0 z-50 bg-background/80 backdrop-blur-lg border-b border-border">
  <div class="container mx-auto px-4 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/formula-care" class="flex items-center gap-2">
        <div class="w-10 h-10 rounded-xl bg-gradient-hero flex items-center justify-center">
          <Beaker class="w-5 h-5 text-primary-foreground" />
        </div>
        <div class="flex flex-col">
          <span class="font-display text-xl font-bold text-foreground leading-tight">
            FormulaFarma
          </span>
          <span class="text-xs text-primary font-medium -mt-1">
            Fórmula Care Beta
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-8">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="font-body text-sm font-medium text-muted-foreground hover:text-primary transition-colors"
          >
            {item.label}
          </a>
        ))}
      </div>

      <!-- CTA Button (Desktop) -->
      <div class="hidden md:block">
        <Button variant="hero" href="#cta">
          Solicitar Acceso
        </Button>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="care-mobile-menu-btn"
        class="md:hidden p-2 text-foreground"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        <Menu id="care-menu-icon-open" class="w-6 h-6" />
        <X id="care-menu-icon-close" class="w-6 h-6 hidden" />
      </button>
    </div>

    <!-- Mobile Navigation -->
    <div id="care-mobile-menu" class="hidden md:hidden py-4 border-t border-border">
      <div class="flex flex-col gap-4">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="care-mobile-nav-link font-body text-base font-medium text-muted-foreground hover:text-primary transition-colors py-2"
          >
            {item.label}
          </a>
        ))}
        <Button variant="hero" href="#cta" class="mt-2">
          Solicitar Acceso
        </Button>
      </div>
    </div>
  </div>
</nav>

<script>
  const menuBtn = document.getElementById('care-mobile-menu-btn');
  const mobileMenu = document.getElementById('care-mobile-menu');
  const iconOpen = document.getElementById('care-menu-icon-open');
  const iconClose = document.getElementById('care-menu-icon-close');
  
  menuBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.contains('hidden');
    
    if (isOpen) {
      mobileMenu?.classList.remove('hidden');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      menuBtn?.setAttribute('aria-expanded', 'true');
    } else {
      mobileMenu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      menuBtn?.setAttribute('aria-expanded', 'false');
    }
  });

  document.querySelectorAll('.care-mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      menuBtn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
