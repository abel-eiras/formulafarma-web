---
import { Menu, X, ArrowLeft } from 'lucide-astro';
import Button from '@/components/ui/Button.astro';

const navItems = [
  { label: 'Funcionalidades', href: '#funcionalidades' },
  { label: 'Cómo Funciona', href: '#como-funciona' },
  { label: 'FAQ', href: '#faq' },
];
---

<nav id="care-navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-150 bg-transparent">
  <div class="container mx-auto px-4 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <div class="flex items-center gap-4">
        <a href="/" class="flex items-center gap-3 group">
          <img 
            src="/logo.webp" 
            alt="Fórmula Farma" 
            class="w-10 h-10 lg:w-12 lg:h-12 brutal-border"
          />
          <span class="font-display text-xl lg:text-2xl font-bold text-foreground uppercase tracking-tight">
            FormulaFarma
          </span>
        </a>
        <div class="hidden sm:flex items-center gap-2 text-muted-foreground">
          <span class="text-border">/</span>
          <span class="text-sm font-bold text-primary uppercase">Fórmula Care</span>
          <span class="text-xs px-2 py-0.5 bg-accent text-accent-foreground font-bold uppercase">Beta</span>
        </div>
      </div>

      <div class="hidden md:flex items-center gap-6">
        <a href="/" class="font-body text-sm font-bold text-foreground hover:text-primary transition-colors flex items-center gap-1 uppercase">
          <ArrowLeft class="w-4 h-4" />
          Inicio
        </a>
        <span class="text-border">|</span>
        {navItems.map((item) => (
          <a href={item.href} class="font-body text-sm font-bold text-foreground hover:text-primary transition-colors uppercase">
            {item.label}
          </a>
        ))}
      </div>

      <div class="hidden md:flex items-center gap-3">
        <Button variant="outline" size="sm" href="#cta">
          Solicitar Acceso
        </Button>
        <Button variant="hero" size="sm" href="https://formula-care.vercel.app/" target="_blank" rel="noopener">
          Probar App
        </Button>
      </div>

      <button
        id="care-mobile-menu-btn"
        class="md:hidden p-2 text-foreground"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        <Menu id="care-menu-icon-open" class="w-6 h-6" />
        <X id="care-menu-icon-close" class="w-6 h-6 hidden" />
      </button>
    </div>

    <div id="care-mobile-menu" class="hidden md:hidden py-4 border-t-4 border-foreground bg-background">
      <div class="flex flex-col gap-4">
        <a href="/" class="care-mobile-nav-link font-body text-base font-bold text-primary transition-colors py-2 flex items-center gap-2 uppercase">
          <ArrowLeft class="w-4 h-4" />
          Volver a Inicio
        </a>
        <div class="border-t-2 border-foreground pt-4">
          {navItems.map((item) => (
            <a href={item.href} class="care-mobile-nav-link font-body text-base font-bold text-foreground hover:text-primary transition-colors py-2 block uppercase">
              {item.label}
            </a>
          ))}
        </div>
        <div class="flex flex-col gap-2 mt-2">
          <Button variant="hero" href="https://formula-care.vercel.app/" target="_blank" rel="noopener">
            Probar App
          </Button>
          <Button variant="outline" href="#cta">
            Solicitar Acceso
          </Button>
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  const navbar = document.getElementById('care-navbar');
  function updateCareNavbar() {
    if (window.scrollY > 20) {
      navbar?.classList.add('bg-background', 'border-b-4', 'border-foreground');
      navbar?.classList.remove('bg-transparent');
    } else {
      navbar?.classList.remove('bg-background', 'border-b-4', 'border-foreground');
      navbar?.classList.add('bg-transparent');
    }
  }
  window.addEventListener('scroll', updateCareNavbar);
  updateCareNavbar();

  const menuBtn = document.getElementById('care-mobile-menu-btn');
  const mobileMenu = document.getElementById('care-mobile-menu');
  const iconOpen = document.getElementById('care-menu-icon-open');
  const iconClose = document.getElementById('care-menu-icon-close');
  
  menuBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.contains('hidden');
    if (isOpen) {
      mobileMenu?.classList.remove('hidden');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      menuBtn?.setAttribute('aria-expanded', 'true');
    } else {
      mobileMenu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      menuBtn?.setAttribute('aria-expanded', 'false');
    }
  });

  document.querySelectorAll('.care-mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      menuBtn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
