---
import { Stethoscope, Droplets, Settings, FileText, BarChart3, Users, HeartHandshake, CalendarClock, ShieldCheck } from 'lucide-astro';

const features = [
  {
    icon: 'stethoscope',
    title: 'Asesoramiento Dermocosmético',
    description: 'Registra consultas, recomienda productos y haz seguimiento sin perder el hilo. ¿Que vuelve en 2 semanas? Lo tendrás todo a mano.',
    highlight: 'Disponible',
  },
  {
    icon: 'droplets',
    title: 'Parámetros Bioquímicos',
    description: 'Glucosa, colesterol, tensión... con aviso de valores fuera de rango. Y ahora también riesgo cardiovascular (SCORE2) y test de diabetes (FINDRISC), calculados solos.',
    highlight: 'Nuevo',
  },
  {
    icon: 'heart',
    title: 'Nutrición (con GLP-1)',
    description: 'Programa completo por paciente: objetivo, visitas de seguimiento, evolución de peso y, si toma un GLP-1, dosis y efectos secundarios.',
    highlight: 'Nuevo',
  },
  {
    icon: 'filetext',
    title: 'Fichas de Paciente',
    description: '¿Los tenías en Excel? Impórtalos de una vez con la plantilla de la app: avisa de errores y no duplica a nadie. Historial completo siempre a mano.',
    highlight: 'Personalizable',
  },
  {
    icon: 'calendar',
    title: 'Citas y Calendario',
    description: 'Calendario con todas tus citas, recordatorio automático el día antes por email o WhatsApp, y aviso de cumpleaños de tus pacientes.',
    highlight: 'Nuevo',
  },
  {
    icon: 'barchart',
    title: 'Informes con tu Marca',
    description: 'Cada servicio genera un informe con el logo y los colores de tu farmacia: imprimir, guardar en PDF o enviar por correo al paciente.',
    highlight: 'Disponible',
  },
  {
    icon: 'shield',
    title: 'Seguridad y RGPD',
    description: 'Copias de seguridad automáticas y cifradas, cierre de sesión si el ordenador queda desatendido, registro de accesos y consentimiento RGPD de cada paciente.',
    highlight: 'Reforzado',
  },
  {
    icon: 'settings',
    title: '100% Configurable',
    description: '¿Cada farmacia es un mundo? Exacto. Por eso puedes configurar TODO. Campos, temas, textos de correo... Si lo necesitas, lo tienes.',
    highlight: 'Flexible',
  },
  {
    icon: 'users',
    title: 'Multiusuario',
    description: 'Cada persona del equipo con su cuenta y su contraseña, en el mismo ordenador de la farmacia. Sin "¿dónde guardaste eso?".',
    highlight: 'Colaborativo',
  },
];
---

<section id="funcionalidades" class="py-24 bg-secondary">
  <div class="container mx-auto px-4 lg:px-8">
    <div class="text-center mb-16 animate-fade-up">
      <span class="inline-block px-4 py-2 bg-accent text-accent-foreground font-body text-xs font-bold uppercase tracking-widest mb-4">
        Funcionalidades
      </span>
      <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-foreground mb-6">
        Todo lo que necesitas (sin lo que no necesitas)
      </h2>
      <p class="font-body text-lg text-muted-foreground max-w-2xl mx-auto">
        Nada de módulos que nunca usarás. Solo herramientas útiles para 
        ofrecer servicios profesionales sin volverte loco.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {features.map((feature, index) => (
        <div
          class="animate-fade-up group relative bg-card brutal-border p-8 brutal-hover"
          style={`animation-delay: ${0.1 + index * 0.05}s;`}
        >
          <div class="absolute -top-3 right-6">
            <span class="inline-block px-3 py-1 bg-accent text-accent-foreground text-xs font-bold uppercase">
              {feature.highlight}
            </span>
          </div>

          <div class="w-14 h-14 bg-foreground flex items-center justify-center mb-6">
            {feature.icon === 'stethoscope' && <Stethoscope class="w-7 h-7 text-background" />}
            {feature.icon === 'droplets' && <Droplets class="w-7 h-7 text-background" />}
            {feature.icon === 'heart' && <HeartHandshake class="w-7 h-7 text-background" />}
            {feature.icon === 'filetext' && <FileText class="w-7 h-7 text-background" />}
            {feature.icon === 'calendar' && <CalendarClock class="w-7 h-7 text-background" />}
            {feature.icon === 'barchart' && <BarChart3 class="w-7 h-7 text-background" />}
            {feature.icon === 'shield' && <ShieldCheck class="w-7 h-7 text-background" />}
            {feature.icon === 'settings' && <Settings class="w-7 h-7 text-background" />}
            {feature.icon === 'users' && <Users class="w-7 h-7 text-background" />}
          </div>

          <h3 class="font-display text-xl font-bold text-foreground mb-3">
            {feature.title}
          </h3>
          <p class="font-body text-muted-foreground leading-relaxed">
            {feature.description}
          </p>
        </div>
      ))}
    </div>

    <!-- Bottom Note -->
    <div class="mt-16 text-center animate-fade-up" style="animation-delay: 0.5s;">
      <p class="text-muted-foreground mb-2">
        ¿Falta algo? Dime.
      </p>
      <p class="text-foreground font-medium">
        Literalmente estoy construyendo esto contigo. (Y no lo digo por decir, de verdad leo todos los mensajes)
      </p>
    </div>
  </div>
</section>
