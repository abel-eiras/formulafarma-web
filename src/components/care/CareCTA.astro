---
import { ArrowRight, Sparkles, Users, Send } from 'lucide-astro';
import Button from '@/components/ui/Button.astro';
---

<section id="cta" class="py-24 bg-gradient-hero relative overflow-hidden">
  <!-- Background Elements -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-10 left-10 w-64 h-64 bg-primary-foreground rounded-full blur-3xl"></div>
    <div class="absolute bottom-10 right-10 w-96 h-96 bg-primary-foreground rounded-full blur-3xl"></div>
  </div>

  <div class="container mx-auto px-4 lg:px-8 relative z-10">
    <div class="max-w-4xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-10 animate-fade-up">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary-foreground/10 border border-primary-foreground/20 mb-6">
          <Sparkles class="w-4 h-4 text-primary-foreground" />
          <span class="text-sm font-medium text-primary-foreground">
            Plazas limitadas
          </span>
        </div>

        <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-primary-foreground mb-6">
          ¿Quieres probar Fórmula Care?
        </h2>
        <p class="font-body text-lg md:text-xl text-primary-foreground/80 mb-10 max-w-2xl mx-auto">
          Estamos seleccionando farmacias para la fase beta. Acceso gratuito, 
          funcionalidades completas y un canal directo para darnos tu opinión.
        </p>
      </div>

      <!-- Form -->
      <div class="animate-fade-up bg-primary-foreground/10 backdrop-blur rounded-2xl p-8 md:p-10 mb-10" style="animation-delay: 0.1s;">
        <form id="care-contact-form" class="space-y-6">
          <div class="grid md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label for="care-name" class="block text-sm font-medium text-primary-foreground">
                Nombre
              </label>
              <input
                type="text"
                id="care-name"
                name="name"
                required
                placeholder="Tu nombre"
                class="w-full h-10 px-4 rounded-md bg-primary-foreground/10 border border-primary-foreground/20 text-primary-foreground placeholder:text-primary-foreground/50 focus:border-primary-foreground focus:outline-none focus:ring-2 focus:ring-primary-foreground/30 transition-colors"
              />
            </div>
            <div class="space-y-2">
              <label for="care-pharmacy" class="block text-sm font-medium text-primary-foreground">
                Farmacia
              </label>
              <input
                type="text"
                id="care-pharmacy"
                name="pharmacy"
                required
                placeholder="Nombre de tu farmacia"
                class="w-full h-10 px-4 rounded-md bg-primary-foreground/10 border border-primary-foreground/20 text-primary-foreground placeholder:text-primary-foreground/50 focus:border-primary-foreground focus:outline-none focus:ring-2 focus:ring-primary-foreground/30 transition-colors"
              />
            </div>
          </div>

          <div class="grid md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label for="care-email" class="block text-sm font-medium text-primary-foreground">
                Email
              </label>
              <input
                type="email"
                id="care-email"
                name="email"
                required
                placeholder="tu@email.com"
                class="w-full h-10 px-4 rounded-md bg-primary-foreground/10 border border-primary-foreground/20 text-primary-foreground placeholder:text-primary-foreground/50 focus:border-primary-foreground focus:outline-none focus:ring-2 focus:ring-primary-foreground/30 transition-colors"
              />
            </div>
            <div class="space-y-2">
              <label for="care-phone" class="block text-sm font-medium text-primary-foreground">
                Teléfono (opcional)
              </label>
              <input
                type="tel"
                id="care-phone"
                name="phone"
                placeholder="Tu teléfono"
                class="w-full h-10 px-4 rounded-md bg-primary-foreground/10 border border-primary-foreground/20 text-primary-foreground placeholder:text-primary-foreground/50 focus:border-primary-foreground focus:outline-none focus:ring-2 focus:ring-primary-foreground/30 transition-colors"
              />
            </div>
          </div>

          <div class="flex justify-center pt-4">
            <Button type="submit" variant="accent" size="xl" class="w-full md:w-auto">
              <Send class="w-5 h-5" />
              Solicitar Acceso Beta
            </Button>
          </div>
        </form>

        <!-- Success Message -->
        <div id="care-form-success" class="hidden text-center py-8">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-accent/20 mb-4">
            <Sparkles class="w-8 h-8 text-primary-foreground" />
          </div>
          <h3 class="font-display text-2xl font-bold text-primary-foreground mb-2">
            ¡Solicitud enviada!
          </h3>
          <p class="text-primary-foreground/80">
            Te contactaremos pronto con los detalles de acceso.
          </p>
        </div>
      </div>

      <!-- Trust Elements -->
      <div class="animate-fade-up flex flex-col sm:flex-row gap-6 justify-center items-center text-primary-foreground/70 text-sm" style="animation-delay: 0.2s;">
        <span>✓ Sin coste durante la beta</span>
        <span>✓ Soporte prioritario</span>
        <span>✓ Precio especial al lanzar</span>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('care-contact-form') as HTMLFormElement;
  const successMessage = document.getElementById('care-form-success');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    
    // TODO: Enviar a endpoint real
    console.log('Care beta form submitted:', data);
    
    form.classList.add('hidden');
    successMessage?.classList.remove('hidden');
  });
</script>
