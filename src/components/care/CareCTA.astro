---
import { ArrowRight, Sparkles, Send, Github } from 'lucide-astro';
import Button from '@/components/ui/Button.astro';
---

<section id="cta" class="py-24 bg-foreground text-background relative overflow-hidden border-t-4 border-primary">
  <div class="container mx-auto px-4 lg:px-8 relative z-10">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-10 animate-fade-up">
        <span class="inline-block px-4 py-2 bg-background text-foreground font-body text-xs font-bold uppercase tracking-widest mb-6">
          Sin plazas, sin prisa
        </span>

        <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-background mb-6 uppercase">
          ¿Quieres instalar Fórmula Care?
        </h2>
        <p class="font-body text-lg md:text-xl text-background/80 mb-6 max-w-2xl mx-auto">
          Descárgalo, instálalo, y en unos minutos tienes tu farmacia dada de alta.
          Y si quieres contarme cómo te ha ido, aquí abajo tienes cómo.
        </p>

        <div class="mb-10">
          <a
            href="https://github.com/abel-eiras/formula-care/releases/latest"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-8 py-4 bg-background text-foreground font-bold text-lg uppercase tracking-wide brutal-border brutal-hover"
          >
            <Sparkles class="w-5 h-5" />
            Descargar Fórmula Care
            <ArrowRight class="w-5 h-5" />
          </a>
          <p class="text-background/60 text-sm mt-3 flex items-center justify-center gap-2">
            <Github class="w-4 h-4" />
            <a href="https://github.com/abel-eiras/formula-care" target="_blank" rel="noopener noreferrer" class="underline hover:no-underline">Código fuente en GitHub</a>
            — licencia MIT.
          </p>
        </div>
      </div>

      <div class="animate-fade-up brutal-border-thick bg-background p-8 md:p-10 mb-10" style="animation-delay: 0.1s;">
        <h3 class="font-display text-xl font-bold text-foreground mb-6 text-center">
          Cuéntame cómo te va (o avísame de tu caso)
        </h3>
        <form id="care-contact-form" action="/contact.php" method="post" class="space-y-6">
          <input type="hidden" name="interest" value="formula-care" />
          <input type="hidden" name="source" value="ficha-programa" />
          <input type="text" name="bot-field" class="hidden" tabindex="-1" autocomplete="off" />
          <div class="grid md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label for="care-name" class="font-body text-xs font-bold uppercase tracking-widest text-foreground">
                Nombre
              </label>
              <input
                type="text"
                id="care-name"
                name="name"
                required
                placeholder="Tu nombre"
                class="w-full h-12 rounded-none border-2 border-foreground bg-background font-body text-sm px-4 focus:ring-0 focus:border-primary"
              />
            </div>
            <div class="space-y-2">
              <label for="care-pharmacy" class="font-body text-xs font-bold uppercase tracking-widest text-foreground">
                Farmacia (opcional)
              </label>
              <input
                type="text"
                id="care-pharmacy"
                name="pharmacy"
                placeholder="Nombre de tu farmacia"
                class="w-full h-12 rounded-none border-2 border-foreground bg-background font-body text-sm px-4 focus:ring-0 focus:border-primary"
              />
            </div>
          </div>

          <div class="space-y-2">
            <label for="care-email" class="font-body text-xs font-bold uppercase tracking-widest text-foreground">
              Email
            </label>
            <input
              type="email"
              id="care-email"
              name="email"
              required
              placeholder="tu@email.com"
              class="w-full h-12 rounded-none border-2 border-foreground bg-background font-body text-sm px-4 focus:ring-0 focus:border-primary"
            />
          </div>

          <div class="flex justify-center pt-4">
            <Button type="submit" variant="accent" size="xl" class="w-full md:w-auto">
              <Send class="w-5 h-5" />
              Enviar
            </Button>
          </div>
        </form>

        <div id="care-form-success" class="hidden text-center py-8">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-accent mb-4">
            <Sparkles class="w-8 h-8 text-accent-foreground" />
          </div>
          <h3 class="font-display text-2xl font-bold text-foreground mb-2">
            ¡Mensaje enviado!
          </h3>
          <p class="text-muted-foreground">
            Te contesto en cuanto pueda.
          </p>
        </div>
      </div>

      <div class="animate-fade-up flex flex-col sm:flex-row gap-6 justify-center items-center text-background/70 text-sm font-body" style="animation-delay: 0.2s;">
        <span>✓ Sin coste, nunca</span>
        <span>✓ Tus datos, en tu ordenador</span>
        <span>✓ Código público, licencia MIT</span>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('care-contact-form') as HTMLFormElement;
  const successMessage = document.getElementById('care-form-success');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    try {
      const res = await fetch(form.getAttribute('action') || '/contact.php', {
        method: 'POST',
        body: formData,
      });
      if (res.ok) {
        window.location.href = '/gracias';
      } else {
        const data = await res.json().catch(() => ({}));
        alert(data.error || 'Error al enviar. Escríbeme a abel@formulafarma.com');
      }
    } catch {
      alert('Error de conexión. Escríbeme a abel@formulafarma.com');
    }
  });
</script>
