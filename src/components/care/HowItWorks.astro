---
import { MousePointerClick, MessageSquare, Code2, GitFork, CheckCircle, Sparkles } from 'lucide-astro';

const steps = [
  {
    icon: 'click',
    step: '01',
    title: 'Pruébalo',
    description: 'Entra en la app, sin registro previo ni formularios. Explora, configura y regístrate directamente si te convence.',
    highlight: 'Sin dar de alta nada',
  },
  {
    icon: 'message',
    step: '02',
    title: 'Cuéntame qué falla',
    description: 'Bugs, cosas que no entiendes, funciones que echas en falta. Todo eso lo leo yo, no un buzón de sugerencias que nadie mira.',
    highlight: 'Tu voz importa',
  },
  {
    icon: 'code',
    step: '03',
    title: 'Sigue el código',
    description: 'Estoy preparando el repositorio para publicarlo: limpiar configuración, escribir documentación. Licencia MIT ya elegida. En camino.',
    highlight: 'Próximamente en GitHub',
  },
  {
    icon: 'fork',
    step: '04',
    title: 'Contribuye si te apetece',
    description: 'Cuando el repo sea público, cualquier mejora es bienvenida — programes mucho o programes poco pero conozcas bien el oficio.',
    highlight: 'Opcional, no obligatorio',
  },
];

const honesties = [
  'Sin letra pequeña',
  'Sin "contacta con ventas"',
  'Sin límite de pacientes convertido en muro de pago',
  'Sin fecha de caducidad para lo gratis',
];
---

<section id="como-funciona" class="py-24 bg-background">
  <div class="container mx-auto px-4 lg:px-8">
    <div class="text-center mb-16 animate-fade-up">
      <span class="inline-block px-4 py-2 bg-accent text-accent-foreground font-body text-xs font-bold uppercase tracking-widest mb-4">
        <Sparkles class="w-4 h-4 inline mr-2" />
        Cómo funciona esto
      </span>
      <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-foreground mb-6">
        Ni funnel, ni truco
      </h2>
      <p class="font-body text-lg text-muted-foreground max-w-2xl mx-auto">
        No hay "plazas limitadas" ni cuenta atrás. Fórmula Care se usa ya,
        se sigue mejorando con quien lo usa, y el código va camino de hacerse público.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 mb-16">
      {steps.map((step, index) => (
        <div class="animate-fade-up relative" style={`animation-delay: ${0.1 + index * 0.1}s;`}>
          <!-- Connector Line -->
          {index < steps.length - 1 && (
            <div class="hidden lg:block absolute top-12 left-[60%] w-full h-0.5 bg-gradient-to-r from-primary/30 to-transparent"></div>
          )}

          <div class="bg-card brutal-border p-6 h-full brutal-hover">
            <div class="absolute -top-3 left-6">
              <span class="inline-block px-3 py-1 bg-primary text-primary-foreground text-xs font-bold uppercase">
                {step.highlight}
              </span>
            </div>

            <div class="flex items-center gap-4 mb-4 mt-2">
              <div class="w-12 h-12 bg-foreground flex items-center justify-center">
                {step.icon === 'click' && <MousePointerClick class="w-6 h-6 text-background" />}
                {step.icon === 'message' && <MessageSquare class="w-6 h-6 text-background" />}
                {step.icon === 'code' && <Code2 class="w-6 h-6 text-background" />}
                {step.icon === 'fork' && <GitFork class="w-6 h-6 text-background" />}
              </div>
              <span class="font-display text-4xl font-bold text-primary/20">
                {step.step}
              </span>
            </div>

            <h3 class="font-display text-lg font-bold text-foreground mb-2">
              {step.title}
            </h3>
            <p class="font-body text-sm text-muted-foreground leading-relaxed">
              {step.description}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Honesty Box -->
    <div class="animate-fade-up bg-foreground text-background brutal-border-thick p-8 md:p-12" style="animation-delay: 0.5s;">
      <div class="max-w-3xl mx-auto text-center">
        <h3 class="font-display text-2xl md:text-3xl font-bold text-background mb-6 uppercase">
          Lo que no vas a encontrar aquí
        </h3>
        <div class="grid sm:grid-cols-2 gap-4">
          {honesties.map((honesty) => (
            <div class="flex items-center gap-3 text-background/90">
              <CheckCircle class="w-5 h-5 text-accent flex-shrink-0" />
              <span class="font-body">{honesty}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
