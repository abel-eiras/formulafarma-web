---
import { UserPlus, TestTube, MessageSquare, Rocket, CheckCircle, Sparkles } from 'lucide-astro';

const steps = [
  {
    icon: 'userplus',
    step: '01',
    title: 'Solicita Acceso',
    description: 'Rellena el formulario de acceso a la beta. Te contamos todo sobre la plataforma y cómo puede ayudarte.',
    highlight: 'Sin compromiso',
  },
  {
    icon: 'testtube',
    step: '02',
    title: 'Prueba Fórmula Care',
    description: 'Accede a todas las funcionalidades durante el período de prueba. Explora, configura y registra tus primeros servicios.',
    highlight: 'Acceso completo',
  },
  {
    icon: 'message',
    step: '03',
    title: 'Comparte tu Feedback',
    description: 'Tu opinión es oro. Nos cuentas qué funciona, qué falta y qué mejorar. Construimos juntos la herramienta perfecta.',
    highlight: 'Tu voz importa',
  },
  {
    icon: 'rocket',
    step: '04',
    title: 'Ventajas Exclusivas',
    description: 'Los usuarios beta tendrán condiciones especiales cuando lancemos la versión final. Tu confianza tiene recompensa.',
    highlight: 'Precio especial',
  },
];

const benefits = [
  'Acceso gratuito durante la beta',
  'Todas las funcionalidades incluidas',
  'Soporte directo y personalizado',
  'Precio especial al lanzamiento',
];
---

<section id="como-funciona" class="py-24 bg-background">
  <div class="container mx-auto px-4 lg:px-8">
    <div class="text-center mb-16 animate-fade-up">
      <span class="inline-block px-4 py-2 rounded-full bg-accent/20 text-accent-foreground text-sm font-medium mb-4">
        <Sparkles class="w-4 h-4 inline mr-2" />
        Únete a la Beta
      </span>
      <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-foreground mb-6">
        Sé de los primeros en probarlo
      </h2>
      <p class="font-body text-lg text-muted-foreground max-w-2xl mx-auto">
        Estamos buscando farmacias que quieran probar Fórmula Care antes del 
        lanzamiento oficial. Plazas limitadas.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 mb-16">
      {steps.map((step, index) => (
        <div class="animate-fade-up relative" style={`animation-delay: ${0.1 + index * 0.1}s;`}>
          <!-- Connector Line -->
          {index < steps.length - 1 && (
            <div class="hidden lg:block absolute top-12 left-[60%] w-full h-0.5 bg-gradient-to-r from-primary/30 to-transparent"></div>
          )}

          <div class="bg-card rounded-2xl p-6 shadow-soft border border-border hover:border-primary/30 transition-all duration-300 h-full">
            <!-- Step Badge -->
            <div class="absolute -top-3 left-6">
              <span class="inline-block px-3 py-1 rounded-full bg-primary text-primary-foreground text-xs font-bold">
                {step.highlight}
              </span>
            </div>

            <div class="flex items-center gap-4 mb-4 mt-2">
              <div class="w-12 h-12 rounded-xl bg-gradient-hero flex items-center justify-center">
                {step.icon === 'userplus' && <UserPlus class="w-6 h-6 text-primary-foreground" />}
                {step.icon === 'testtube' && <TestTube class="w-6 h-6 text-primary-foreground" />}
                {step.icon === 'message' && <MessageSquare class="w-6 h-6 text-primary-foreground" />}
                {step.icon === 'rocket' && <Rocket class="w-6 h-6 text-primary-foreground" />}
              </div>
              <span class="font-display text-4xl font-bold text-primary/20">
                {step.step}
              </span>
            </div>

            <h3 class="font-display text-lg font-bold text-foreground mb-2">
              {step.title}
            </h3>
            <p class="font-body text-sm text-muted-foreground leading-relaxed">
              {step.description}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Benefits Box -->
    <div class="animate-fade-up bg-gradient-hero rounded-2xl p-8 md:p-12" style="animation-delay: 0.5s;">
      <div class="max-w-3xl mx-auto text-center">
        <h3 class="font-display text-2xl md:text-3xl font-bold text-primary-foreground mb-6">
          ¿Qué ganas siendo usuario beta?
        </h3>
        <div class="grid sm:grid-cols-2 gap-4">
          {benefits.map((benefit) => (
            <div class="flex items-center gap-3 text-primary-foreground/90">
              <CheckCircle class="w-5 h-5 text-accent flex-shrink-0" />
              <span class="font-body">{benefit}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
