---
import { Beaker, Mail } from 'lucide-astro';

const currentYear = new Date().getFullYear();

const careLinks = [
  { label: 'Funcionalidades', href: '#funcionalidades' },
  { label: 'Unirse a la Beta', href: '#como-funciona' },
  { label: 'Por qué Beta', href: '#beta' },
  { label: 'Sobre Nosotros', href: '#nosotros' },
];

const legalLinks = [
  { label: 'Aviso Legal', href: '/aviso-legal' },
  { label: 'Política de Privacidad', href: '/privacidad' },
  { label: 'Términos y Condiciones', href: '/aviso-legal' },
  { label: 'Política de Cookies', href: '/privacidad' },
];
---

<footer class="bg-foreground text-background py-16">
  <div class="container mx-auto px-4 lg:px-8">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <a href="/formula-care" class="flex items-center gap-2 mb-4">
          <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center">
            <Beaker class="w-5 h-5 text-primary-foreground" />
          </div>
          <div class="flex flex-col">
            <span class="font-display text-xl font-bold">
              FormulaFarma
            </span>
            <span class="text-xs text-primary">
              Fórmula Care Beta
            </span>
          </div>
        </a>
        <p class="text-background/70 max-w-md mb-6 font-body">
          Software diseñado para farmacias. Fórmula Care es nuestra primera 
          herramienta: gestión de servicios asistenciales simple y potente.
        </p>
        <div class="flex items-center gap-2 text-sm text-background/60">
          <Mail class="w-4 h-4" />
          <span>hola@formulafarma.com</span>
        </div>
      </div>

      <!-- Fórmula Care -->
      <div>
        <h4 class="font-display font-bold text-lg mb-4">Fórmula Care</h4>
        <ul class="space-y-2 text-background/70 font-body">
          {careLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-primary transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h4 class="font-display font-bold text-lg mb-4">Legal</h4>
        <ul class="space-y-2 text-background/70 font-body">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-primary transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-background/10 pt-8">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-background/60 text-sm font-body">
          © {currentYear} FormulaFarma. Todos los derechos reservados.
        </p>
        <p class="text-background/40 text-xs font-body">
          Fórmula Care está actualmente en fase beta.
        </p>
      </div>
    </div>
  </div>
</footer>
