---
import { ArrowRight, Sparkles } from 'lucide-astro';
import Button from '@/components/ui/Button.astro';
---

<section class="relative min-h-screen flex items-center pt-20 overflow-hidden bg-gradient-mesh">
  <!-- Background Elements -->
  <div class="absolute inset-0 z-0">
    <div class="absolute top-20 right-20 w-[500px] h-[500px] bg-primary/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 left-20 w-[400px] h-[400px] bg-accent/5 rounded-full blur-3xl"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-primary/3 rounded-full blur-3xl"></div>
  </div>

  <div class="container mx-auto px-4 lg:px-8 relative z-10">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Badge -->
      <div class="animate-fade-up" style="animation-delay: 0s;">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 border border-primary/20 mb-8">
          <Sparkles class="w-4 h-4 text-primary" />
          <span class="text-sm font-semibold text-primary">
            Tecnología farmacéutica sin humo
          </span>
        </div>
      </div>

      <!-- Title -->
      <div class="animate-fade-up" style="animation-delay: 0.1s;">
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-extrabold text-foreground leading-tight mb-6">
          Menos Excel.{" "}
          <span class="text-gradient-primary">Más pacientes.</span>
        </h1>
      </div>

      <!-- Description -->
      <div class="animate-fade-up" style="animation-delay: 0.2s;">
        <p class="font-body text-lg md:text-xl text-muted-foreground mb-10 max-w-2xl mx-auto leading-relaxed">
          Software y automatizaciones creadas por farmacéuticos que estaban{" "}
          <strong class="text-foreground">hartos de lo mismo que tú.</strong>
        </p>
      </div>

      <!-- CTA Buttons -->
      <div class="animate-fade-up" style="animation-delay: 0.3s;">
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button variant="hero" size="xl" href="/formula-care">
            Ver Software
            <ArrowRight class="w-5 h-5" />
          </Button>
          <Button variant="outline" size="xl" href="#contacto">
            Consultoría a Medida
          </Button>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Wave -->
  <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-background to-transparent"></div>
</section>
