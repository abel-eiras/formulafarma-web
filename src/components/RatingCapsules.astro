---
interface Props {
  postSlug: string;
}

const { postSlug } = Astro.props;
---

<div class="rating-capsules-container my-12 py-8 border-t border-gray-200">
  <h3 class="text-xl font-semibold text-pharma-dark mb-4">Valora este post</h3>
  
  <div class="flex flex-col gap-4">
    <!-- Cápsulas de valoración -->
    <div class="flex items-center gap-2 flex-wrap" id="rating-capsules" data-post-slug={postSlug}>
      <button
        type="button"
        class="rating-capsule bg-gray-200 text-gray-600 rounded-full px-4 py-2 text-sm font-medium transition-all hover:bg-pharma-soft hover:text-pharma-accent hover:scale-105"
        data-rating="0"
        aria-label="Valorar con 0"
      >
        0
      </button>
      <button
        type="button"
        class="rating-capsule bg-gray-200 text-gray-600 rounded-full px-4 py-2 text-sm font-medium transition-all hover:bg-pharma-soft hover:text-pharma-accent hover:scale-105"
        data-rating="1"
        aria-label="Valorar con 1"
      >
        1
      </button>
      <button
        type="button"
        class="rating-capsule bg-gray-200 text-gray-600 rounded-full px-4 py-2 text-sm font-medium transition-all hover:bg-pharma-soft hover:text-pharma-accent hover:scale-105"
        data-rating="2"
        aria-label="Valorar con 2"
      >
        2
      </button>
      <button
        type="button"
        class="rating-capsule bg-gray-200 text-gray-600 rounded-full px-4 py-2 text-sm font-medium transition-all hover:bg-pharma-soft hover:text-pharma-accent hover:scale-105"
        data-rating="3"
        aria-label="Valorar con 3"
      >
        3
      </button>
      <button
        type="button"
        class="rating-capsule bg-gray-200 text-gray-600 rounded-full px-4 py-2 text-sm font-medium transition-all hover:bg-pharma-soft hover:text-pharma-accent hover:scale-105"
        data-rating="4"
        aria-label="Valorar con 4"
      >
        4
      </button>
      <button
        type="button"
        class="rating-capsule bg-gray-200 text-gray-600 rounded-full px-4 py-2 text-sm font-medium transition-all hover:bg-pharma-soft hover:text-pharma-accent hover:scale-105"
        data-rating="5"
        aria-label="Valorar con 5"
      >
        5
      </button>
    </div>
    
    <!-- Estadísticas -->
    <div class="rating-stats text-sm text-pharma-grey" id="rating-stats">
      <span id="rating-average">-</span>
      <span class="mx-2">•</span>
      <span id="rating-count">0 valoraciones</span>
    </div>
    
    <!-- Mensaje de estado -->
    <div class="rating-message text-sm" id="rating-message"></div>
  </div>
</div>

<script>
  (function() {
    const container = document.getElementById('rating-capsules');
    if (!container) return;
    
    const postSlug = container.dataset.postSlug;
    const capsules = container.querySelectorAll('.rating-capsule');
    const statsEl = document.getElementById('rating-stats');
    const averageEl = document.getElementById('rating-average');
    const countEl = document.getElementById('rating-count');
    const messageEl = document.getElementById('rating-message');
    
    let currentUserRating = null;
    let isLoading = false;
    
    // Cargar estadísticas iniciales
    async function loadRatings() {
      try {
        const response = await fetch(`/api/ratings.php?post=${encodeURIComponent(postSlug)}`);
        const data = await response.json();
        
        if (data.success) {
          // Actualizar estadísticas
          if (data.count > 0) {
            averageEl.textContent = `Promedio: ${data.average}/5`;
            countEl.textContent = `${data.count} ${data.count === 1 ? 'valoración' : 'valoraciones'}`;
          } else {
            averageEl.textContent = 'Sin valoraciones aún';
            countEl.textContent = '0 valoraciones';
          }
          
          // Actualizar cápsula del usuario si tiene rating
          if (data.user_rating !== null) {
            currentUserRating = data.user_rating;
            updateCapsules();
          }
        }
      } catch (error) {
        console.error('Error cargando valoraciones:', error);
      }
    }
    
    // Actualizar visualización de cápsulas
    function updateCapsules() {
      capsules.forEach(capsule => {
        const rating = parseInt(capsule.dataset.rating);
        if (currentUserRating !== null && rating === currentUserRating) {
          // Cápsula activa (valoración del usuario)
          capsule.classList.remove('bg-gray-200', 'text-gray-600');
          capsule.classList.add('bg-pharma-accent', 'text-white');
          capsule.classList.remove('hover:bg-pharma-soft', 'hover:text-pharma-accent');
        } else if (currentUserRating === null) {
          // Sin valoración, todas disponibles
          capsule.classList.remove('bg-pharma-accent', 'text-white');
          capsule.classList.add('bg-gray-200', 'text-gray-600');
          capsule.classList.add('hover:bg-pharma-soft', 'hover:text-pharma-accent');
        } else {
          // Ya hay valoración, otras cápsulas deshabilitadas pero visibles
          capsule.classList.remove('bg-pharma-accent', 'text-white');
          capsule.classList.add('bg-gray-200', 'text-gray-600', 'opacity-50');
          capsule.classList.remove('hover:bg-pharma-soft', 'hover:text-pharma-accent', 'hover:scale-105');
        }
      });
    }
    
    // Enviar valoración
    async function submitRating(rating) {
      if (isLoading) return;
      
      isLoading = true;
      messageEl.textContent = 'Enviando valoración...';
      messageEl.className = 'rating-message text-sm text-pharma-accent';
      
      try {
        const response = await fetch('/api/ratings.php', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            post_slug: postSlug,
            rating: rating
          })
        });
        
        const data = await response.json();
        
        if (data.success) {
          currentUserRating = rating;
          updateCapsules();
          
          // Actualizar estadísticas
          averageEl.textContent = `Promedio: ${data.average}/5`;
          countEl.textContent = `${data.count} ${data.count === 1 ? 'valoración' : 'valoraciones'}`;
          
          messageEl.textContent = '¡Valoración guardada!';
          messageEl.className = 'rating-message text-sm text-green-600';
          
          setTimeout(() => {
            messageEl.textContent = '';
          }, 3000);
        } else {
          messageEl.textContent = data.message || 'Error al guardar la valoración';
          messageEl.className = 'rating-message text-sm text-red-600';
        }
      } catch (error) {
        console.error('Error enviando valoración:', error);
        messageEl.textContent = 'Error de conexión. Intenta de nuevo.';
        messageEl.className = 'rating-message text-sm text-red-600';
      } finally {
        isLoading = false;
      }
    }
    
    // Event listeners para cápsulas
    capsules.forEach(capsule => {
      capsule.addEventListener('click', () => {
        const rating = parseInt(capsule.dataset.rating);
        submitRating(rating);
      });
    });
    
    // Cargar datos al iniciar
    loadRatings();
    updateCapsules();
  })();
</script>

<style>
  .rating-capsule {
    cursor: pointer;
    user-select: none;
  }
  
  .rating-capsule:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }
</style>

