---
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const { 
  src, 
  alt, 
  width = 800, 
  height = 600, 
  loading = 'lazy',
  class: className = ''
} = Astro.props;

// Si la imagen es relativa, asegurarse de que tenga el prefijo correcto
const imageSrc = src.startsWith('/') ? src : `/${src}`;
---

<img 
  src={imageSrc}
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  decoding="async"
  class={className}
/>

