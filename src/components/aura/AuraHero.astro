---
import { ArrowRight, Mic, Download, AlertTriangle } from 'lucide-astro';
import Button from '@/components/ui/Button.astro';
---

<section class="relative min-h-screen flex items-center pt-20 overflow-hidden bg-background">
  <div class="absolute inset-0 z-0 opacity-[0.04]">
    <div
      class="absolute inset-0"
      style="background-image: repeating-linear-gradient(0deg, hsl(0 0% 5%) 0px, hsl(0 0% 5%) 1px, transparent 1px, transparent 80px), repeating-linear-gradient(90deg, hsl(0 0% 5%) 0px, hsl(0 0% 5%) 1px, transparent 1px, transparent 80px);"
    />
  </div>

  <div class="absolute top-32 right-12 w-40 h-40 bg-primary rotate-12 hidden lg:block" />
  <div class="absolute bottom-40 left-8 w-24 h-24 bg-accent -rotate-6 hidden lg:block" />

  <div class="container mx-auto px-4 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div class="max-w-2xl">
        <div class="animate-fade-up" style="animation-delay: 0s;">
          <div class="inline-block px-4 py-2 bg-foreground text-background font-body text-xs font-bold uppercase tracking-widest mb-6">
            App Android — código abierto — v0.4.1
          </div>
        </div>

        <div class="animate-fade-up" style="animation-delay: 0.1s;">
          <h1 class="font-display text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-bold text-foreground leading-[0.95] mb-6">
            Tú grabas.{" "}
            <span class="text-primary italic">Aura apunta lo importante.</span>
          </h1>
        </div>

        <div class="animate-fade-up" style="animation-delay: 0.2s;">
          <p class="font-body text-base md:text-lg text-muted-foreground mb-4 leading-relaxed">
            Esas grabadoras con inteligencia artificial que se llevan en el bolsillo, graban la reunión
            y te devuelven el acta redactada están muy bien… hasta que ves que cuestan más de 100 € y
            que lo bueno se paga con suscripción.{" "}
            <strong class="text-foreground">Aura hace lo mismo con el móvil que ya tienes, gratis.</strong>
          </p>
        </div>

        <div class="animate-fade-up" style="animation-delay: 0.25s;">
          <p class="font-body text-base text-muted-foreground mb-6">
            Graba reuniones, visitas y notas de voz, <strong class="text-foreground">separa quién dice qué</strong> y
            te deja la nota redactada. Sin servidor mío, sin cuenta que crear, sin cuotas.
          </p>
        </div>

        <div class="animate-fade-up" style="animation-delay: 0.28s;">
          <div class="flex items-start gap-3 brutal-border bg-secondary p-4 mb-8 max-w-xl">
            <AlertTriangle class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" />
            <p class="font-body text-sm text-foreground">
              <strong>No está en la Play Store</strong> (ni va a estar). Se descarga como un archivo
              <code class="font-mono">.apk</code> y se instala en un minuto. Abajo tienes cómo.
            </p>
          </div>
        </div>

        <div class="animate-fade-up" style="animation-delay: 0.3s;">
          <div class="flex flex-col sm:flex-row gap-4 mb-12">
            <Button variant="hero" size="xl" href="https://github.com/abel-eiras/aura-app/releases/latest" target="_blank" rel="noopener noreferrer">
              <Download class="w-5 h-5" />
              Descargar Aura
            </Button>
            <Button variant="outline" size="xl" href="#instalar">
              Cómo se instala
              <ArrowRight class="w-5 h-5" />
            </Button>
          </div>
        </div>
      </div>

      <div class="hidden lg:block">
        <div class="relative">
          <div class="brutal-border-thick bg-foreground p-8">
            <div class="border-4 border-background/30 p-6 space-y-6">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-primary flex items-center justify-center">
                  <Mic class="w-6 h-6 text-primary-foreground" />
                </div>
                <div>
                  <p class="font-display font-bold text-background text-lg">Aura</p>
                  <p class="text-xs text-background/50 font-body uppercase tracking-widest">Grabando · 00:42:17</p>
                </div>
              </div>
              <div class="space-y-2">
                <div class="h-3 bg-background/20 w-full" />
                <div class="h-3 bg-background/20 w-4/5" />
                <div class="h-3 bg-background/15 w-3/5" />
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div class="border-2 border-background/30 p-4">
                  <p class="text-xs text-background/50 font-body uppercase">Hablante 1 / 2</p>
                  <p class="font-display font-bold text-lg text-accent">✓</p>
                </div>
                <div class="border-2 border-background/30 p-4">
                  <p class="text-xs text-background/50 font-body uppercase">Nota redactada</p>
                  <p class="font-display font-bold text-lg text-accent">✓</p>
                </div>
              </div>
            </div>
          </div>
          <div class="absolute -bottom-4 -left-4 brutal-border bg-card p-4 shadow-elevated">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-foreground flex items-center justify-center">
                <Mic class="w-5 h-5 text-background" />
              </div>
              <div>
                <div class="font-display text-xl font-bold text-foreground">0 €</div>
                <p class="text-xs text-muted-foreground">Sin dispositivo ni suscripción</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 right-0 h-1 bg-foreground" />
</section>
