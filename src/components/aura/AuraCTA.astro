---
import { ArrowRight, Sparkles, Send, Github, Download } from 'lucide-astro';
import Button from '@/components/ui/Button.astro';
---

<section id="cta" class="py-24 bg-foreground text-background relative overflow-hidden border-t-4 border-primary">
  <div class="container mx-auto px-4 lg:px-8 relative z-10">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-10 animate-fade-up">
        <span class="inline-block px-4 py-2 bg-background text-foreground font-body text-xs font-bold uppercase tracking-widest mb-6">
          v0.4.1 disponible para Android
        </span>

        <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-background mb-6 uppercase">
          ¿Pruebas Aura?
        </h2>
        <p class="font-body text-lg md:text-xl text-background/80 mb-6 max-w-2xl mx-auto">
          Descárgala, pruébala y cuéntame qué tal. Recuerda: no está en la Play Store,
          se instala desde el APK y después se actualiza sola desde la app.
        </p>

        <div class="mb-6">
          <a
            href="https://github.com/abel-eiras/aura-app/releases/latest"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-8 py-4 bg-background text-foreground font-bold text-lg uppercase tracking-wide brutal-border brutal-hover"
          >
            <Download class="w-5 h-5" />
            Descargar Aura (APK)
            <ArrowRight class="w-5 h-5" />
          </a>
        </div>

        <p class="text-background/60 text-sm mb-10 flex items-center justify-center gap-2">
          <Github class="w-4 h-4" />
          <a href="https://github.com/abel-eiras/aura-app" target="_blank" rel="noopener noreferrer" class="underline hover:no-underline">Código fuente en GitHub</a>
          — licencia MIT.
        </p>
      </div>

      <div class="animate-fade-up brutal-border-thick bg-background p-8 md:p-10" style="animation-delay: 0.1s;">
        <h3 class="font-display text-xl font-bold text-foreground mb-6 text-center">
          Cuéntame cómo te va con Aura
        </h3>
        <form id="aura-contact-form" action="/contact.php" method="post" class="space-y-6">
          <input type="hidden" name="interest" value="aura" />
          <input type="hidden" name="source" value="ficha-programa" />
          <input type="text" name="bot-field" class="hidden" tabindex="-1" autocomplete="off" />
          <div class="grid md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label for="aura-name" class="font-body text-xs font-bold uppercase tracking-widest text-foreground">
                Nombre
              </label>
              <input
                type="text"
                id="aura-name"
                name="name"
                required
                placeholder="Tu nombre"
                class="w-full h-12 rounded-none border-2 border-foreground bg-background font-body text-sm px-4 focus:ring-0 focus:border-primary"
              />
            </div>
            <div class="space-y-2">
              <label for="aura-pharmacy" class="font-body text-xs font-bold uppercase tracking-widest text-foreground">
                Farmacia o empresa (opcional)
              </label>
              <input
                type="text"
                id="aura-pharmacy"
                name="pharmacy"
                placeholder="Si quieres contármelo"
                class="w-full h-12 rounded-none border-2 border-foreground bg-background font-body text-sm px-4 focus:ring-0 focus:border-primary"
              />
            </div>
          </div>

          <div class="space-y-2">
            <label for="aura-email" class="font-body text-xs font-bold uppercase tracking-widest text-foreground">
              Email
            </label>
            <input
              type="email"
              id="aura-email"
              name="email"
              required
              placeholder="tu@email.com"
              class="w-full h-12 rounded-none border-2 border-foreground bg-background font-body text-sm px-4 focus:ring-0 focus:border-primary"
            />
          </div>

          <div class="space-y-2">
            <label for="aura-message" class="font-body text-xs font-bold uppercase tracking-widest text-foreground">
              ¿Ya la has probado? Cuéntame qué tal
            </label>
            <textarea
              id="aura-message"
              name="message"
              rows="3"
              placeholder="Un error que te has encontrado, algo que echas en falta, o para qué la usas..."
              class="w-full rounded-none border-2 border-foreground bg-background font-body text-sm px-4 py-3 focus:ring-0 focus:border-primary resize-none"
            ></textarea>
          </div>

          <div class="flex justify-center pt-4">
            <Button type="submit" variant="accent" size="xl" class="w-full md:w-auto">
              <Send class="w-5 h-5" />
              Enviar
            </Button>
          </div>
        </form>

        <div id="aura-form-success" class="hidden text-center py-8">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-accent mb-4">
            <Sparkles class="w-8 h-8 text-accent-foreground" />
          </div>
          <h3 class="font-display text-2xl font-bold text-foreground mb-2">
            ¡Mensaje enviado!
          </h3>
          <p class="text-muted-foreground">
            Te contesto en cuanto pueda.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('aura-contact-form') as HTMLFormElement;
  const successMessage = document.getElementById('aura-form-success');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    try {
      const res = await fetch(form.getAttribute('action') || '/contact.php', {
        method: 'POST',
        body: formData,
      });
      if (res.ok) {
        window.location.href = '/gracias';
      } else {
        const data = await res.json().catch(() => ({}));
        alert(data.error || 'Error al enviar. Escríbeme a abel@formulafarma.com');
      }
    } catch {
      alert('Error de conexión. Escríbeme a abel@formulafarma.com');
    }
  });
</script>
