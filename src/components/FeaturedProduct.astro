---
import { ArrowRight, HeartPulse, Sparkles } from 'lucide-astro';
import Button from '@/components/ui/Button.astro';

const features = [
  'Asesoramiento dermocosmético (sin recomendar lo más caro, tranqui)',
  'Control de parámetros bioquímicos (sin ser médico, ojo)',
  'Fichas de paciente que de verdad se entienden',
  '100% personalizable (de verdad, no como el de la competencia)',
];
---

<section id="producto" class="py-24 bg-background">
  <div class="container mx-auto px-4 lg:px-8">
    <div class="animate-fade-up">
      <div class="brutal-border-thick bg-card">
        <div class="grid lg:grid-cols-2">
          <!-- Content -->
          <div class="p-6 sm:p-8 md:p-12 lg:p-16 lg:pr-10 overflow-visible">
            <div class="inline-block px-4 py-2 bg-accent text-accent-foreground font-body text-xs font-bold uppercase tracking-widest mb-6">
              ★ BETA PRIVADA (O SEA, MEDIO FUNCIONA) ★
            </div>

            <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-foreground mb-6 leading-[0.95]">
              Fórmula Care
            </h2>

            <p class="font-body text-base text-muted-foreground mb-8 leading-relaxed">
              Mi primer engendro digital. Registra servicios dermocosméticos 
              y parámetros bioquímicos sin querer arrancarte los ojos.{" "}
              <strong class="text-foreground">
                Que no es poco, viendo lo que hay en el mercado.
              </strong>
            </p>

            <ul class="space-y-3 mb-8">
              {features.map((feature) => (
                <li class="flex items-center gap-3 text-foreground font-body text-sm">
                  <span class="text-primary font-bold text-lg">→</span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>

            <div class="flex flex-wrap gap-3 mt-6">
              <Button 
                variant="hero" 
                size="lg" 
                href="https://formula-care.vercel.app/" 
                target="_blank" 
                rel="noopener"
                class="!whitespace-normal text-center leading-tight h-auto min-h-12 py-3 px-5 w-full sm:w-auto sm:min-w-0 sm:max-w-[200px]"
              >
                <span class="flex flex-col items-center">
                  <span>Quiero probarlo</span>
                  <span>antes que nadie</span>
                </span>
                <ArrowRight class="w-5 h-5 shrink-0" />
              </Button>
              <Button 
                variant="outline" 
                size="lg" 
                href="/formula-care#cta"
                class="!whitespace-normal text-center leading-tight h-auto min-h-12 py-3 px-5 w-full sm:w-auto sm:min-w-0 sm:max-w-[200px]"
              >
                <span class="flex flex-col">
                  <span>Solicitar</span>
                  <span>acceso (gratis)</span>
                </span>
              </Button>
            </div>
          </div>

          <!-- Visual Mockup -->
          <div class="bg-foreground p-8 md:p-12 lg:p-16 flex items-center justify-center">
            <div class="w-full max-w-sm">
              <div class="border-4 border-background/30 p-6 space-y-6">
                <div class="flex items-center gap-3">
                  <div class="w-12 h-12 bg-primary flex items-center justify-center">
                    <HeartPulse class="w-6 h-6 text-primary-foreground" />
                  </div>
                  <div>
                    <p class="font-display font-bold text-background text-lg">Fórmula Care</p>
                    <p class="text-xs text-background/50 font-body uppercase tracking-widest">v0.algo</p>
                  </div>
                </div>
                
                <div class="space-y-2">
                  <div class="h-3 bg-background/20 w-full" />
                  <div class="h-3 bg-background/20 w-4/5" />
                  <div class="h-3 bg-background/15 w-3/5" />
                </div>

                <div class="grid grid-cols-2 gap-3">
                  <div class="border-2 border-background/30 p-4">
                    <p class="text-xs text-background/50 font-body uppercase">Pacientes</p>
                    <p class="font-display font-bold text-3xl text-accent">127</p>
                  </div>
                  <div class="border-2 border-background/30 p-4">
                    <p class="text-xs text-background/50 font-body uppercase">Cafés</p>
                    <p class="font-display font-bold text-3xl text-accent">∞</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
