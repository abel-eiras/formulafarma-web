---
import { languages, defaultLang } from '../i18n/ui';
import { getLangFromUrl, useTranslatedPath, getRouteFromUrl } from '../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const currentPath = Astro.url.pathname;
const translatePath = useTranslatedPath(currentLang);

// Función para traducir la ruta actual al otro idioma
function getTranslatedCurrentPath(targetLang: string): string {
  const route = getRouteFromUrl(Astro.url);
  
  // Si ya estamos en el idioma objetivo, devolver la misma ruta
  if (currentLang === targetLang) {
    return currentPath;
  }
  
  // Rutas especiales que tienen traducciones específicas
  const routeTranslations: Record<string, { gl: string; es: string }> = {
    '/sobre-mi': { gl: '/sobre-min', es: '/sobre-mi' },
    '/sobre-min': { gl: '/sobre-min', es: '/sobre-mi' },
    '/privacidad': { gl: '/privacidade', es: '/privacidad' },
    '/privacidade': { gl: '/privacidade', es: '/privacidad' },
  };
  
  // Si es una ruta que tiene traducción específica
  if (routeTranslations[currentPath]) {
    const translated = routeTranslations[currentPath][targetLang as 'gl' | 'es'];
    return targetLang === defaultLang ? translated : `/${targetLang}${translated}`;
  }
  
  // Manejar rutas de blog
  // Ruta exacta /blog (listado)
  if (currentPath === '/blog') {
    return targetLang === defaultLang ? '/blog' : '/es/blog';
  }
  
  // Ruta exacta /es/blog (listado en español)
  if (currentPath === '/es/blog') {
    return targetLang === defaultLang ? '/blog' : '/es/blog';
  }
  
  // Rutas de blog con contenido
  if (currentPath.startsWith('/blog/')) {
    // Es un post individual o categoría
    const slug = currentPath.replace('/blog/', '');
    
    // Si es una categoría
    if (slug.startsWith('categoria/')) {
      const categorySlug = slug.replace('categoria/', '');
      return targetLang === defaultLang 
        ? `/blog/categoria/${categorySlug}`
        : `/es/blog/categoria/${categorySlug}`;
    }
    
    // Es un post individual - usar el mismo slug
    return targetLang === defaultLang 
      ? `/blog/${slug}`
      : `/es/blog/${slug}`;
  }
  
  // Para rutas en /es/
  if (currentPath.startsWith('/es/')) {
    const pathWithoutLang = currentPath.replace('/es', '');
    
    // Ruta exacta /blog
    if (pathWithoutLang === '/blog') {
      return '/blog';
    }
    
    // Si es ruta de blog con contenido
    if (pathWithoutLang.startsWith('/blog/')) {
      const slug = pathWithoutLang.replace('/blog/', '');
      if (slug.startsWith('categoria/')) {
        const categorySlug = slug.replace('categoria/', '');
        return `/blog/categoria/${categorySlug}`;
      }
      return `/blog/${slug}`;
    }
    
    // Otras rutas en /es/
    if (pathWithoutLang in routeTranslations) {
      return routeTranslations[pathWithoutLang].gl;
    }
    return pathWithoutLang;
  }
  
  // Otras rutas
  if (currentPath in routeTranslations) {
    const translated = routeTranslations[currentPath][targetLang as 'gl' | 'es'];
    return targetLang === defaultLang ? translated : `/${targetLang}${translated}`;
  }
  
  // Si no hay traducción específica, solo cambiar el prefijo de idioma
  if (targetLang === defaultLang) {
    // Quitar prefijo /es/ si existe
    return currentPath.startsWith('/es') ? currentPath.replace('/es', '') : currentPath;
  } else {
    // Añadir prefijo /es/ si no existe
    return currentPath.startsWith('/es') ? currentPath : `/${targetLang}${currentPath}`;
  }
}
---

<div class="flex gap-2 font-tech text-xs uppercase font-bold">
    {Object.entries(languages).map(([langKey, label]) => (
        <a 
            href={getTranslatedCurrentPath(langKey)}
            class={`px-2 py-1 border-2 border-black transition-all ${
                currentLang === langKey 
                ? 'bg-black text-white' 
                : 'bg-white hover:bg-yellow-300'
            }`}
        >
            {langKey}
        </a>
    ))}
</div>





