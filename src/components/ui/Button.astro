---
import { cn } from '@/lib/utils';

interface Props {
  variant?: 'default' | 'outline' | 'hero' | 'accent' | 'ghost';
  size?: 'default' | 'sm' | 'lg' | 'xl';
  href?: string;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  target?: string;
  rel?: string;
}

const { 
  variant = 'default', 
  size = 'default', 
  href, 
  class: className,
  type = 'button',
  ...props 
} = Astro.props;

const baseStyles = 'inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-none text-sm font-medium font-body uppercase tracking-wide ring-offset-background transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50';

const variants = {
  default: 'bg-primary text-primary-foreground brutal-border brutal-hover',
  outline: 'border-2 border-foreground bg-transparent text-foreground brutal-hover',
  hero: 'bg-primary text-primary-foreground brutal-border brutal-hover',
  accent: 'bg-accent text-accent-foreground brutal-border brutal-hover',
  ghost: 'hover:bg-muted hover:text-foreground',
};

const sizes = {
  default: 'h-10 px-4 py-2',
  sm: 'h-9 px-3',
  lg: 'h-12 px-8 text-base',
  xl: 'h-14 px-10 text-lg',
};

const classes = cn(baseStyles, variants[variant], sizes[size], className);

const Element = href ? 'a' : 'button';
---

{href ? (
  <a href={href} class={classes} {...props}>
    <slot />
  </a>
) : (
  <button type={type} class={classes} {...props}>
    <slot />
  </button>
)}