---
interface Props {
  button1Text: string;
  button1Href?: string;
  button1External?: boolean;
  button1Variant?: 'primary' | 'secondary';
  button2Text: string;
  button2Href?: string;
  button2External?: boolean;
  button2Variant?: 'primary' | 'secondary';
  class?: string;
  gap?: string;
}

const { 
  button1Text,
  button1Href,
  button1External = false,
  button1Variant = 'primary',
  button2Text,
  button2Href,
  button2External = false,
  button2Variant = 'primary',
  class: className = '',
  gap = 'gap-4'
} = Astro.props;

// Clases base do estilo brutal
const baseClasses = 'inline-block border-2 border-black shadow-[6px_6px_0px_#000] font-semibold transition-all hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[8px_8px_0px_#000] active:translate-x-[2px] active:translate-y-[2px] active:shadow-[2px_2px_0px_#000] px-6 py-4 min-w-[120px] text-center';

const getVariantClasses = (variant: 'primary' | 'secondary') => 
  variant === 'primary' ? 'bg-white text-black' : 'bg-black text-white';

// Determinar se son enlaces externos
const button1IsExternal = button1External || (button1Href && (button1Href.startsWith('http://') || button1Href.startsWith('https://')));
const button2IsExternal = button2External || (button2Href && (button2Href.startsWith('http://') || button2Href.startsWith('https://')));

// Classes finais para cada botón
const button1Classes = `${baseClasses} ${getVariantClasses(button1Variant)}`;
const button2Classes = `${baseClasses} ${getVariantClasses(button2Variant)}`;
---

<div class={`flex flex-wrap ${gap} my-8 ${className}`}>
  {button1Href ? (
    <a 
      href={button1Href}
      target={button1IsExternal ? "_blank" : undefined}
      rel={button1IsExternal ? "noopener noreferrer" : undefined}
      class={button1Classes}
    >
      {button1Text}
    </a>
  ) : (
    <button 
      type="button"
      class={button1Classes}
    >
      {button1Text}
    </button>
  )}
  
  {button2Href ? (
    <a 
      href={button2Href}
      target={button2IsExternal ? "_blank" : undefined}
      rel={button2IsExternal ? "noopener noreferrer" : undefined}
      class={button2Classes}
    >
      {button2Text}
    </a>
  ) : (
    <button 
      type="button"
      class={button2Classes}
    >
      {button2Text}
    </button>
  )}
</div>

