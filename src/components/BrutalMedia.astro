---
interface Props {
  src: string;
  alt: string;
  type?: 'image' | 'video';
  class?: string;
  href?: string;
}

const { 
  src, 
  alt, 
  type = 'image',
  class: className = '',
  href
} = Astro.props;

// Asegurar que a ruta ten o prefixo correcto
const mediaSrc = src.startsWith('/') ? src : `/${src}`;

// Clases base do estilo brutal
const brutalClasses = 'w-full h-auto border-2 border-black shadow-[6px_6px_0px_#000] my-8';
const finalClasses = className ? `${brutalClasses} ${className}` : brutalClasses;

// Determinar se é un enlace externo
const isExternal = href?.startsWith('http://') || href?.startsWith('https://');
---

{href ? (
  <a 
    href={href}
    target={isExternal ? "_blank" : undefined}
    rel={isExternal ? "noopener noreferrer" : undefined}
    class="block"
  >
    {type === 'video' ? (
      <video 
        src={mediaSrc}
        autoplay
        loop
        muted
        playsinline
        class={finalClasses}
        aria-label={alt}
      />
    ) : (
      <img 
        src={mediaSrc}
        alt={alt}
        loading="lazy"
        decoding="async"
        class={finalClasses}
      />
    )}
  </a>
) : (
  type === 'video' ? (
    <video 
      src={mediaSrc}
      autoplay
      loop
      muted
      playsinline
      class={finalClasses}
      aria-label={alt}
    />
  ) : (
    <img 
      src={mediaSrc}
      alt={alt}
      loading="lazy"
      decoding="async"
      class={finalClasses}
    />
  )
)}

