---
import CommentForm from './CommentForm.astro';
import { useTranslations } from '../i18n/utils';

interface Props {
  postSlug: string;
  lang?: 'gl' | 'es';
}

const { postSlug, lang = 'gl' } = Astro.props;
const t = useTranslations(lang);

// Exportar traducciones para JavaScript
const translations = {
  loading: t('comments.loading'),
  empty: t('comments.empty'),
  errorLoad: t('comments.error.load'),
  errorConnection: t('comments.error.connection'),
};
---

<div class="comments-section my-12 py-8 border-t-2 border-black" data-post-slug={postSlug} data-lang={lang} data-translations={JSON.stringify(translations)}>
  <h3 class="text-2xl font-semibold mb-6 font-human">{t('comments.title')}</h3>
  
  <!-- Lista de comentarios -->
  <div id="comments-list" class="space-y-6 mb-8">
    <div class="text-center py-8 font-tech" id="comments-loading">
      {t('comments.loading')}
    </div>
  </div>
  
  <!-- Formulario de comentarios -->
  <CommentForm postSlug={postSlug} lang={lang} />
</div>

<script>
  (function() {
    const commentsList = document.getElementById('comments-list');
    const loadingEl = document.getElementById('comments-loading');
    if (!commentsList || !loadingEl) return;
    
    const commentsSection = document.querySelector('[data-post-slug]');
    const postSlug = commentsSection?.dataset.postSlug || '';
    const lang = commentsSection?.dataset.lang || 'gl';
    const translations = commentsSection?.dataset.translations ? JSON.parse(commentsSection.dataset.translations) : {};
    
    // Función global para recargar comentarios
    window.reloadComments = loadComments;
    
    async function loadComments() {
      try {
        loadingEl.textContent = translations.loading || 'Cargando comentarios...';
        loadingEl.className = 'text-center text-pharma-grey py-8';
        
        const response = await fetch(`/api/comments.php?post=${encodeURIComponent(postSlug)}`);
        const data = await response.json();
        
        if (data.success) {
          if (data.comments && data.comments.length > 0) {
            renderComments(data.comments);
            loadingEl.style.display = 'none';
          } else {
            loadingEl.textContent = translations.empty || 'Aún no hay comentarios. ¡Sé el primero en comentar!';
            loadingEl.className = 'text-center py-8 italic font-tech';
          }
        } else {
          loadingEl.textContent = translations.errorLoad || 'Error al cargar los comentarios.';
          loadingEl.className = 'text-center text-red-600 py-8 font-tech';
        }
      } catch (error) {
        console.error('Error cargando comentarios:', error);
        loadingEl.textContent = translations.errorConnection || 'Error de conexión. Intenta recargar la página.';
        loadingEl.className = 'text-center text-red-600 py-8 font-tech';
      }
    }
    
    function renderComments(comments) {
      commentsList.innerHTML = '';
      
      comments.forEach(comment => {
        const commentEl = document.createElement('div');
        commentEl.className = 'comment-item border-b-2 border-black py-4 font-tech text-sm';
        
        const date = new Date(comment.created_at);
        const formattedDate = date.toLocaleDateString(lang === 'gl' ? 'gl-ES' : 'es-ES', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
          hour: '2-digit',
          minute: '2-digit'
        });
        
        commentEl.innerHTML = `
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0">
              <div class="w-10 h-10 border-2 border-black bg-black text-white flex items-center justify-center font-bold font-tech">
                ${comment.author_name.charAt(0).toUpperCase()}
              </div>
            </div>
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-2">
                <span class="font-bold">${escapeHtml(comment.author_name)}</span>
                <span class="text-xs">${formattedDate}</span>
              </div>
              <div class="leading-relaxed whitespace-pre-wrap">${escapeHtml(comment.content)}</div>
            </div>
          </div>
        `;
        
        commentsList.appendChild(commentEl);
      });
    }
    
    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }
    
    // Cargar comentarios al iniciar
    loadComments();
  })();
</script>

<style>
  .comment-item {
    animation: fadeIn 0.3s ease-in;
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
