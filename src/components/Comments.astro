---
import CommentForm from './CommentForm.astro';

interface Props {
  postSlug: string;
}

const { postSlug } = Astro.props;
---

<div class="comments-section my-12 py-8 border-t border-gray-200" data-post-slug={postSlug}>
  <h3 class="text-2xl font-semibold text-pharma-dark mb-6">Comentarios</h3>
  
  <!-- Lista de comentarios -->
  <div id="comments-list" class="space-y-6 mb-8">
    <div class="text-center text-pharma-grey py-8" id="comments-loading">
      Cargando comentarios...
    </div>
  </div>
  
  <!-- Formulario de comentarios -->
  <CommentForm postSlug={postSlug} />
</div>

<script>
  (function() {
    const commentsList = document.getElementById('comments-list');
    const loadingEl = document.getElementById('comments-loading');
    if (!commentsList || !loadingEl) return;
    
    const postSlug = document.querySelector('[data-post-slug]')?.dataset.postSlug || '';
    
    // Función global para recargar comentarios
    window.reloadComments = loadComments;
    
    async function loadComments() {
      try {
        loadingEl.textContent = 'Cargando comentarios...';
        loadingEl.className = 'text-center text-pharma-grey py-8';
        
        const response = await fetch(`/api/comments.php?post=${encodeURIComponent(postSlug)}`);
        const data = await response.json();
        
        if (data.success) {
          if (data.comments && data.comments.length > 0) {
            renderComments(data.comments);
            loadingEl.style.display = 'none';
          } else {
            loadingEl.textContent = 'Aún no hay comentarios. ¡Sé el primero en comentar!';
            loadingEl.className = 'text-center text-pharma-grey py-8 italic';
          }
        } else {
          loadingEl.textContent = 'Error al cargar los comentarios.';
          loadingEl.className = 'text-center text-red-600 py-8';
        }
      } catch (error) {
        console.error('Error cargando comentarios:', error);
        loadingEl.textContent = 'Error de conexión. Intenta recargar la página.';
        loadingEl.className = 'text-center text-red-600 py-8';
      }
    }
    
    function renderComments(comments) {
      commentsList.innerHTML = '';
      
      comments.forEach(comment => {
        const commentEl = document.createElement('div');
        commentEl.className = 'comment-item border-b border-gray-200 pb-6 last:border-b-0';
        
        const date = new Date(comment.created_at);
        const formattedDate = date.toLocaleDateString('es-ES', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
          hour: '2-digit',
          minute: '2-digit'
        });
        
        commentEl.innerHTML = `
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0">
              <div class="w-10 h-10 rounded-full bg-pharma-accent text-white flex items-center justify-center font-semibold">
                ${comment.author_name.charAt(0).toUpperCase()}
              </div>
            </div>
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-2">
                <span class="font-semibold text-pharma-dark">${escapeHtml(comment.author_name)}</span>
                <span class="text-xs text-pharma-grey">${formattedDate}</span>
              </div>
              <div class="text-pharma-dark leading-relaxed whitespace-pre-wrap">${escapeHtml(comment.content)}</div>
            </div>
          </div>
        `;
        
        commentsList.appendChild(commentEl);
      });
    }
    
    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }
    
    // Cargar comentarios al iniciar
    loadComments();
  })();
</script>

<style>
  .comment-item {
    animation: fadeIn 0.3s ease-in;
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

