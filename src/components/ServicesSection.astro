---
import { Code, Zap, Users } from 'lucide-astro';

const services = [
  {
    icon: 'code',
    number: '01',
    title: 'Desarrollo a Medida',
    description: '¿Tienes un proceso que te hace perder 2 horas al día y nadie lo entiende excepto tú? Yo lo entiendo y entre los dos nos peleamos por crear una solución.',
  },
  {
    icon: 'zap',
    number: '02',
    title: 'Automatizaciones',
    description: 'Esas tareas que repites 47 veces al día... ¿y si las hicieras 0? Flujos automáticos que trabajan mientras tú desayunas.',
  },
  {
    icon: 'users',
    number: '03',
    title: 'Mentorías 1 a 1',
    description: 'Sin humo. Sin buzzwords. Sesiones donde resuelvo TUS problemas, no los del manual genérico de "digitaliza tu negocio".',
  },
];
---

<section id="servicios" class="py-24 bg-foreground text-background">
  <div class="container mx-auto px-4 lg:px-8">
    <div class="animate-fade-up mb-16">
      <span class="inline-block px-4 py-2 bg-accent text-accent-foreground font-body text-xs font-bold uppercase tracking-widest mb-6">
        Lo que hago (además de dispensar)
      </span>
      <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-background leading-[0.95]">
        Más allá del<br />mostrador
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-0">
      {services.map((service, index) => (
        <div 
          class="animate-fade-up border-2 border-background/20 p-8 lg:p-10 h-full brutal-hover group hover:bg-primary transition-colors duration-150 cursor-default"
          style={`animation-delay: ${0.1 + index * 0.1}s;`}
        >
          <div class="flex items-start justify-between mb-8">
            <span class="font-display text-6xl font-bold text-background/10 group-hover:text-primary-foreground/20 transition-colors">
              {service.number}
            </span>
            {service.icon === 'code' && <Code class="w-8 h-8 text-accent group-hover:text-primary-foreground transition-colors" />}
            {service.icon === 'zap' && <Zap class="w-8 h-8 text-accent group-hover:text-primary-foreground transition-colors" />}
            {service.icon === 'users' && <Users class="w-8 h-8 text-accent group-hover:text-primary-foreground transition-colors" />}
          </div>

          <h3 class="font-display text-2xl font-bold text-background mb-4 group-hover:text-primary-foreground transition-colors">
            {service.title}
          </h3>
          <p class="font-body text-sm text-background/60 leading-relaxed group-hover:text-primary-foreground/80 transition-colors">
            {service.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
