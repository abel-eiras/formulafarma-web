---
import { Code, Zap, Users } from 'lucide-astro';

const services = [
  {
    icon: 'code',
    title: 'Desarrollo a Medida',
    description: '¿Tienes un proceso que te hace perder 2 horas al día y nadie lo entiende excepto tú? Yo lo entiendo. Y lo convierto en software.',
  },
  {
    icon: 'zap',
    title: 'Automatizaciones',
    description: 'Esas tareas que repites 47 veces al día... ¿y si las hicieras 0? Flujos automáticos que trabajan mientras tú desayunas.',
  },
  {
    icon: 'users',
    title: 'Mentorías 1 a 1',
    description: 'Sin humo. Sin buzzwords. Sesiones donde resolvemos TUS problemas, no los del manual genérico de "digitaliza tu negocio".',
  },
];
---

<section id="servicios" class="py-24 bg-muted/30">
  <div class="container mx-auto px-4 lg:px-8">
    <!-- Header -->
    <div class="animate-fade-up text-center mb-16">
      <span class="inline-block px-4 py-2 rounded-full bg-accent/10 text-accent text-sm font-medium mb-4">
        Lo que hago
      </span>
      <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-foreground mb-6">
        Tecnología que soluciona problemas reales
      </h2>
      <p class="font-body text-lg text-muted-foreground max-w-2xl mx-auto">
        Nada de "transformación digital" vacía. Herramientas concretas para 
        problemas concretos. Y si no existe, lo creo.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid md:grid-cols-3 gap-8">
      {services.map((service, index) => (
        <div 
          class="animate-fade-up group relative bg-card rounded-2xl p-8 shadow-soft hover:shadow-elevated transition-all duration-300 border border-border hover:border-primary/30 h-full hover-lift icon-wiggle"
          style={`animation-delay: ${0.1 + index * 0.1}s;`}
        >
          <div class="w-14 h-14 rounded-xl bg-gradient-hero flex items-center justify-center mb-6 group-hover:scale-110 group-hover:rotate-3 transition-transform duration-300">
            {service.icon === 'code' && <Code class="w-7 h-7 text-primary-foreground" />}
            {service.icon === 'zap' && <Zap class="w-7 h-7 text-primary-foreground" />}
            {service.icon === 'users' && <Users class="w-7 h-7 text-primary-foreground" />}
          </div>

          <h3 class="font-display text-xl font-bold text-foreground mb-3">
            {service.title}
          </h3>
          <p class="font-body text-muted-foreground leading-relaxed">
            {service.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
