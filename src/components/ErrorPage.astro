---
/**
 * Plantilla común para las páginas de error (403, 404, 500, 503).
 *
 * El servidor las sirve en cualquier URL (ErrorDocument en .htaccess), así que
 * todos los enlaces y recursos usan rutas absolutas y la página no se indexa.
 */
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import { Home, ArrowRight, Mail } from 'lucide-astro';

interface Props {
  code: string;
  /** Texto del recuadro negro superior, en el tono de la web. */
  badge: string;
  /** Título de la pestaña del navegador. */
  pageTitle: string;
  /** Titular grande. */
  title: string;
  /** Párrafos explicativos. */
  lines: string[];
  /** Nota pequeña al pie, como el asterisco de la home. */
  footnote?: string;
  /** Mostrar los accesos a los programas (útil en el 404). */
  showPrograms?: boolean;
  /** Mostrar el email de contacto (útil en errores del servidor). */
  showContact?: boolean;
}

const {
  code,
  badge,
  pageTitle,
  title,
  lines,
  footnote,
  showPrograms = false,
  showContact = false,
} = Astro.props;

const programs = [
  { label: 'Fórmula Care', hint: 'el primero', href: '/formula-care' },
  { label: 'SPD', hint: 'el segundo, para Galicia', href: '/spd' },
  { label: 'Aura', hint: 'el tercero, para tu móvil', href: '/aura' },
];
---

<Layout title={pageTitle} description={lines[0]} noindex>
  <main class="relative min-h-screen flex flex-col bg-background overflow-hidden">
    <!-- Cuadrícula de fondo, igual que en la portada -->
    <div class="absolute inset-0 z-0 opacity-[0.04]" aria-hidden="true">
      <div
        class="absolute inset-0"
        style="background-image: repeating-linear-gradient(0deg, hsl(0 0% 5%) 0px, hsl(0 0% 5%) 1px, transparent 1px, transparent 80px), repeating-linear-gradient(90deg, hsl(0 0% 5%) 0px, hsl(0 0% 5%) 1px, transparent 1px, transparent 80px);"
      />
    </div>

    <!-- Bloques de color girados -->
    <div class="absolute top-28 right-12 w-40 h-40 bg-primary rotate-12 hidden lg:block" aria-hidden="true" />
    <div class="absolute bottom-32 right-48 w-24 h-24 bg-accent -rotate-6 hidden lg:block" aria-hidden="true" />

    <!-- Cabecera mínima con el logo -->
    <header class="relative z-10 container mx-auto px-4 lg:px-8 pt-6">
      <a href="/" class="inline-flex items-center gap-3">
        <img src="/logo.webp" alt="" class="w-10 h-10" width="40" height="40" decoding="async" />
        <span class="font-display text-xl font-bold uppercase tracking-tight text-foreground">
          FormulaFarma
        </span>
      </a>
    </header>

    <div class="relative z-10 flex-1 flex items-center">
      <div class="container mx-auto px-4 lg:px-8 py-16">
        <div class="max-w-3xl">
          <div class="animate-fade-up" style="animation-delay: 0s;">
            <div class="inline-block px-4 py-2 bg-foreground text-background font-body text-xs sm:text-sm font-bold uppercase tracking-widest mb-8">
              {badge}
            </div>
          </div>

          <div class="animate-fade-up" style="animation-delay: 0.1s;">
            <p
              class="font-display font-bold text-primary leading-none mb-4 text-8xl md:text-9xl"
              aria-hidden="true"
            >
              {code}
            </p>
            <h1 class="font-display text-4xl md:text-6xl font-bold text-foreground leading-[0.95] mb-8">
              {title}
            </h1>
          </div>

          <div class="animate-fade-up" style="animation-delay: 0.2s;">
            {lines.map((line) => (
              <p class="font-body text-base md:text-lg text-muted-foreground mb-4 max-w-2xl leading-relaxed">
                {line}
              </p>
            ))}
          </div>

          <div class="animate-fade-up mt-10" style="animation-delay: 0.3s;">
            <div class="flex flex-col sm:flex-row gap-4">
              <Button variant="hero" size="lg" href="/">
                <Home class="w-5 h-5" />
                Volver al inicio
              </Button>
              {showContact ? (
                <Button variant="outline" size="lg" href="mailto:abel@formulafarma.com">
                  <Mail class="w-5 h-5" />
                  Avísame del fallo
                </Button>
              ) : (
                <Button variant="outline" size="lg" href="/#contacto">
                  Escríbeme
                  <ArrowRight class="w-5 h-5" />
                </Button>
              )}
            </div>
          </div>

          {showPrograms && (
            <div class="animate-fade-up mt-14" style="animation-delay: 0.4s;">
              <p class="font-body text-xs font-bold uppercase tracking-widest text-foreground mb-4">
                Quizá buscabas uno de estos
              </p>
              <ul class="grid sm:grid-cols-3 gap-4">
                {programs.map((program) => (
                  <li>
                    <a
                      href={program.href}
                      class="block h-full bg-card brutal-border brutal-hover p-4"
                    >
                      <span class="block font-display text-lg font-bold text-foreground">
                        {program.label}
                      </span>
                      <span class="block font-body text-sm text-muted-foreground">
                        {program.hint}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {footnote && (
            <p class="font-body text-xs text-muted-foreground mt-12">
              {footnote}
            </p>
          )}
        </div>
      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0 h-1 bg-foreground" aria-hidden="true" />
  </main>
</Layout>
