---
import { useTranslations } from '../i18n/utils';

interface Props {
  postSlug: string;
  lang?: 'gl' | 'es';
  onCommentAdded?: () => void;
}

const { postSlug, lang = 'gl' } = Astro.props;
const t = useTranslations(lang);

// Exportar traducciones para JavaScript
const translations = {
  title: t('comments.form.title'),
  name: t('comments.form.name'),
  email: t('comments.form.email'),
  namePlaceholder: t('comments.form.name.placeholder'),
  emailPlaceholder: t('comments.form.email.placeholder'),
  content: t('comments.form.content'),
  contentPlaceholder: t('comments.form.content.placeholder'),
  characters: t('comments.form.characters'),
  submit: t('comments.form.submit'),
  sending: t('comments.form.sending'),
  success: t('comments.form.success'),
  errorSubmit: t('comments.form.error.submit'),
  errorConnection: t('comments.form.error.connection'),
  errorName: t('comments.form.error.name'),
  errorContent: t('comments.form.error.content'),
};
---

<form class="comment-form mt-8 space-y-4" id="comment-form" data-post-slug={postSlug} data-lang={lang} data-translations={JSON.stringify(translations)}>
  <h4 class="text-lg font-semibold mb-4 font-human">{t('comments.form.title')}</h4>
  
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label for="author_name" class="block text-sm font-medium mb-2 font-tech">
        {t('comments.form.name')} <span class="text-red-500">*</span>
      </label>
      <input
        type="text"
        id="author_name"
        name="author_name"
        required
        minlength="2"
        maxlength="100"
        class="w-full border-2 border-black p-3 font-tech text-sm focus:outline-none focus:bg-yellow-50 mb-4"
        placeholder={t('comments.form.name.placeholder')}
      />
    </div>
    
    <div>
      <label for="author_email" class="block text-sm font-medium mb-2 font-tech">
        {t('comments.form.email')}
      </label>
      <input
        type="email"
        id="author_email"
        name="author_email"
        maxlength="255"
        class="w-full border-2 border-black p-3 font-tech text-sm focus:outline-none focus:bg-yellow-50 mb-4"
        placeholder={t('comments.form.email.placeholder')}
      />
    </div>
  </div>
  
  <div>
    <label for="content" class="block text-sm font-medium mb-2 font-tech">
      {t('comments.form.content')} <span class="text-red-500">*</span>
    </label>
    <textarea
      id="content"
      name="content"
      required
      minlength="10"
      maxlength="2000"
      rows="5"
      class="w-full border-2 border-black p-3 font-tech text-sm focus:outline-none focus:bg-yellow-50 mb-4"
      placeholder={t('comments.form.content.placeholder')}
    ></textarea>
    <p class="text-xs mt-1 font-tech">
      <span id="char-count">0</span>/2000 {t('comments.form.characters')}
    </p>
  </div>
  
  <div class="comment-message text-sm font-tech" id="comment-message"></div>
  
  <button
    type="submit"
    class="bg-black text-white font-tech font-bold uppercase py-3 px-6 hover:bg-gray-800 transition-colors cursor-pointer border-2 border-transparent hover:border-black disabled:opacity-50 disabled:cursor-not-allowed"
    id="submit-btn"
  >
    {t('comments.form.submit')}
  </button>
</form>

<script>
  (function() {
    const form = document.getElementById('comment-form');
    if (!form) return;
    
    const postSlug = form.dataset.postSlug;
    const translations = form.dataset.translations ? JSON.parse(form.dataset.translations) : {};
    const submitBtn = document.getElementById('submit-btn');
    const messageEl = document.getElementById('comment-message');
    const contentTextarea = document.getElementById('content');
    const charCountEl = document.getElementById('char-count');
    
    let isLoading = false;
    
    // Contador de caracteres
    if (contentTextarea && charCountEl) {
      contentTextarea.addEventListener('input', () => {
        charCountEl.textContent = contentTextarea.value.length;
      });
    }
    
    // Manejar envío del formulario
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      if (isLoading) return;
      
      const formData = new FormData(form);
      const data = {
        post_slug: postSlug,
        author_name: formData.get('author_name'),
        author_email: formData.get('author_email'),
        content: formData.get('content')
      };
      
      // Validación básica
      if (!data.author_name || data.author_name.trim().length < 2) {
        showMessage(translations.errorName || 'El nombre debe tener al menos 2 caracteres', 'error');
        return;
      }
      
      if (!data.content || data.content.trim().length < 10) {
        showMessage(translations.errorContent || 'El comentario debe tener al menos 10 caracteres', 'error');
        return;
      }
      
      isLoading = true;
      submitBtn.disabled = true;
      submitBtn.textContent = translations.sending || 'Enviando...';
      showMessage(translations.sending || 'Enviando comentario...', 'info');
      
      try {
        const response = await fetch('/api/comments.php', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data)
        });
        
        const result = await response.json();
        
        if (result.success) {
          showMessage(translations.success || '¡Comentario enviado correctamente!', 'success');
          form.reset();
          if (charCountEl) charCountEl.textContent = '0';
          
          // Recargar comentarios si hay callback
          if (window.reloadComments) {
            window.reloadComments();
          }
          
          // Scroll suave al nuevo comentario después de un momento
          setTimeout(() => {
            const commentsSection = document.getElementById('comments-list');
            if (commentsSection) {
              commentsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }, 500);
        } else {
          showMessage(result.message || translations.errorSubmit || 'Error al enviar el comentario', 'error');
          if (result.errors) {
            console.error('Errores de validación:', result.errors);
          }
        }
      } catch (error) {
        console.error('Error enviando comentario:', error);
        showMessage(translations.errorConnection || 'Error de conexión. Intenta de nuevo.', 'error');
      } finally {
        isLoading = false;
        submitBtn.disabled = false;
        submitBtn.textContent = translations.submit || 'Enviar comentario';
      }
    });
    
    function showMessage(text, type) {
      if (!messageEl) return;
      
      messageEl.textContent = text;
      messageEl.className = 'comment-message text-sm';
      
      switch (type) {
        case 'success':
          messageEl.classList.add('text-green-600', 'border-2', 'border-black', 'p-2', 'bg-green-50');
          break;
        case 'error':
          messageEl.classList.add('text-red-600', 'border-2', 'border-black', 'p-2', 'bg-red-50');
          break;
        case 'info':
          messageEl.classList.add('border-2', 'border-black', 'p-2', 'bg-yellow-50');
          break;
        default:
          messageEl.classList.add('border-2', 'border-black', 'p-2');
      }
      
      if (type === 'success' || type === 'info') {
        setTimeout(() => {
          if (messageEl) {
            messageEl.textContent = '';
            messageEl.className = 'comment-message text-sm';
          }
        }, 5000);
      }
    }
  })();
</script>
