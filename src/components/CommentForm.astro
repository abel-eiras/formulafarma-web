---
interface Props {
  postSlug: string;
  onCommentAdded?: () => void;
}

const { postSlug } = Astro.props;
---

<form class="comment-form mt-8 space-y-4" id="comment-form" data-post-slug={postSlug}>
  <h4 class="text-lg font-semibold mb-4 font-human">Deja un comentario</h4>
  
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label for="author_name" class="block text-sm font-medium mb-2 font-tech">
        Nombre <span class="text-red-500">*</span>
      </label>
      <input
        type="text"
        id="author_name"
        name="author_name"
        required
        minlength="2"
        maxlength="100"
        class="w-full border-2 border-black p-3 font-tech text-sm focus:outline-none focus:bg-yellow-50 mb-4"
        placeholder="Tu nombre"
      />
    </div>
    
    <div>
      <label for="author_email" class="block text-sm font-medium mb-2 font-tech">
        Email (opcional)
      </label>
      <input
        type="email"
        id="author_email"
        name="author_email"
        maxlength="255"
        class="w-full border-2 border-black p-3 font-tech text-sm focus:outline-none focus:bg-yellow-50 mb-4"
        placeholder="tu@email.com"
      />
    </div>
  </div>
  
  <div>
    <label for="content" class="block text-sm font-medium mb-2 font-tech">
      Comentario <span class="text-red-500">*</span>
    </label>
    <textarea
      id="content"
      name="content"
      required
      minlength="10"
      maxlength="2000"
      rows="5"
      class="w-full border-2 border-black p-3 font-tech text-sm focus:outline-none focus:bg-yellow-50 mb-4"
      placeholder="Escribe tu comentario aquí (mínimo 10 caracteres)..."
    ></textarea>
    <p class="text-xs mt-1 font-tech">
      <span id="char-count">0</span>/2000 caracteres
    </p>
  </div>
  
  <div class="comment-message text-sm font-tech" id="comment-message"></div>
  
  <button
    type="submit"
    class="bg-black text-white font-tech font-bold uppercase py-3 px-6 hover:bg-gray-800 transition-colors cursor-pointer border-2 border-transparent hover:border-black disabled:opacity-50 disabled:cursor-not-allowed"
    id="submit-btn"
  >
    Enviar comentario
  </button>
</form>

<script>
  (function() {
    const form = document.getElementById('comment-form');
    if (!form) return;
    
    const postSlug = form.dataset.postSlug;
    const submitBtn = document.getElementById('submit-btn');
    const messageEl = document.getElementById('comment-message');
    const contentTextarea = document.getElementById('content');
    const charCountEl = document.getElementById('char-count');
    
    let isLoading = false;
    
    // Contador de caracteres
    if (contentTextarea && charCountEl) {
      contentTextarea.addEventListener('input', () => {
        charCountEl.textContent = contentTextarea.value.length;
      });
    }
    
    // Manejar envío del formulario
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      if (isLoading) return;
      
      const formData = new FormData(form);
      const data = {
        post_slug: postSlug,
        author_name: formData.get('author_name'),
        author_email: formData.get('author_email'),
        content: formData.get('content')
      };
      
      // Validación básica
      if (!data.author_name || data.author_name.trim().length < 2) {
        showMessage('El nombre debe tener al menos 2 caracteres', 'error');
        return;
      }
      
      if (!data.content || data.content.trim().length < 10) {
        showMessage('El comentario debe tener al menos 10 caracteres', 'error');
        return;
      }
      
      isLoading = true;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Enviando...';
      showMessage('Enviando comentario...', 'info');
      
      try {
        const response = await fetch('/api/comments.php', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data)
        });
        
        const result = await response.json();
        
        if (result.success) {
          showMessage('¡Comentario enviado correctamente!', 'success');
          form.reset();
          if (charCountEl) charCountEl.textContent = '0';
          
          // Recargar comentarios si hay callback
          if (window.reloadComments) {
            window.reloadComments();
          }
          
          // Scroll suave al nuevo comentario después de un momento
          setTimeout(() => {
            const commentsSection = document.getElementById('comments-list');
            if (commentsSection) {
              commentsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }, 500);
        } else {
          showMessage(result.message || 'Error al enviar el comentario', 'error');
          if (result.errors) {
            console.error('Errores de validación:', result.errors);
          }
        }
      } catch (error) {
        console.error('Error enviando comentario:', error);
        showMessage('Error de conexión. Intenta de nuevo.', 'error');
      } finally {
        isLoading = false;
        submitBtn.disabled = false;
        submitBtn.textContent = 'Enviar comentario';
      }
    });
    
    function showMessage(text, type) {
      if (!messageEl) return;
      
      messageEl.textContent = text;
      messageEl.className = 'comment-message text-sm';
      
      switch (type) {
        case 'success':
          messageEl.classList.add('text-green-600', 'border-2', 'border-black', 'p-2', 'bg-green-50');
          break;
        case 'error':
          messageEl.classList.add('text-red-600', 'border-2', 'border-black', 'p-2', 'bg-red-50');
          break;
        case 'info':
          messageEl.classList.add('border-2', 'border-black', 'p-2', 'bg-yellow-50');
          break;
        default:
          messageEl.classList.add('border-2', 'border-black', 'p-2');
      }
      
      if (type === 'success' || type === 'info') {
        setTimeout(() => {
          if (messageEl) {
            messageEl.textContent = '';
            messageEl.className = 'comment-message text-sm';
          }
        }, 5000);
      }
    }
  })();
</script>

