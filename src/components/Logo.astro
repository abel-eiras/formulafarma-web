---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<a href="/" class={`flex items-center gap-3 ${className}`}>
  <img 
    src="/logo.webp" 
    alt="Fórmula Farma Logo" 
    class="h-10 w-auto"
    width="120"
    height="40"
    loading="eager"
    decoding="async"
  />
  <span class="text-2xl font-semibold text-pharma-dark hover:text-pharma-accent transition-colors">
    Fórmula Farma
  </span>
</a>

