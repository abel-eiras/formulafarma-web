---
import { Sparkles, GitCommitHorizontal, Users, Code2 } from 'lucide-astro';

const status = [
  {
    icon: 'commit',
    title: 'Recién empezado',
    description: 'El repositorio existe y el diseño avanza, pero todavía no hay una app usable. Esta página existe para que sepas que se está cociendo.',
  },
  {
    icon: 'users',
    title: 'Con farmacias reales',
    description: 'Se está pensando junto a farmacias gallegas que hoy hacen SPD a mano, no en un despacho adivinando qué necesitan.',
  },
  {
    icon: 'code',
    title: 'Abierto desde el principio',
    description: 'La idea es que el código sea público desde que haya algo mínimamente presentable — no al final, como "regalo" de última hora.',
  },
];
---

<section id="estado" class="py-24 bg-background">
  <div class="container mx-auto px-4 lg:px-8">
    <div class="text-center mb-16 animate-fade-up">
      <span class="inline-block px-4 py-2 bg-accent text-accent-foreground font-body text-xs font-bold uppercase tracking-widest mb-4">
        <Sparkles class="w-4 h-4 inline mr-2" />
        Estado del proyecto
      </span>
      <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-foreground mb-6">
        Sin fecha de lanzamiento inventada
      </h2>
      <p class="font-body text-lg text-muted-foreground max-w-2xl mx-auto">
        Prefiero decirte "esto está verde todavía" a prometerte una fecha
        que luego no cumplo. Así va, de verdad, ahora mismo.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {status.map((item, index) => (
        <div
          class="animate-fade-up bg-card brutal-border p-8 brutal-hover"
          style={`animation-delay: ${0.1 + index * 0.1}s;`}
        >
          <div class="w-14 h-14 bg-foreground flex items-center justify-center mb-6">
            {item.icon === 'commit' && <GitCommitHorizontal class="w-7 h-7 text-background" />}
            {item.icon === 'users' && <Users class="w-7 h-7 text-background" />}
            {item.icon === 'code' && <Code2 class="w-7 h-7 text-background" />}
          </div>
          <h3 class="font-display text-xl font-bold text-foreground mb-3">
            {item.title}
          </h3>
          <p class="font-body text-muted-foreground leading-relaxed">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
