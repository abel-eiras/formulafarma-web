---
import { Sparkles, Send, Github } from 'lucide-astro';
import Button from '@/components/ui/Button.astro';
---

<section id="cta" class="py-24 bg-foreground text-background relative overflow-hidden border-t-4 border-primary">
  <div class="container mx-auto px-4 lg:px-8 relative z-10">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-10 animate-fade-up">
        <span class="inline-block px-4 py-2 bg-background text-foreground font-body text-xs font-bold uppercase tracking-widest mb-6">
          Sin demo todavía
        </span>

        <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-background mb-6 uppercase">
          ¿Haces SPD a mano en tu farmacia?
        </h2>
        <p class="font-body text-lg md:text-xl text-background/80 mb-2 max-w-2xl mx-auto">
          Cuéntamelo. Así de simple. Cómo lo haces hoy, qué documento te quita
          más tiempo, y te aviso en cuanto haya algo que probar.
        </p>
        <p class="text-background/60 text-sm mt-4 mb-10 flex items-center justify-center gap-2">
          <Github class="w-4 h-4" />
          El repositorio aún no es público — en cuanto lo sea, lo verás enlazado aquí.
        </p>
      </div>

      <div class="animate-fade-up brutal-border-thick bg-background p-8 md:p-10" style="animation-delay: 0.1s;">
        <form id="spd-contact-form" action="/contact.php" method="post" class="space-y-6">
          <input type="hidden" name="interest" value="spd" />
          <input type="hidden" name="source" value="ficha-programa" />
          <input type="text" name="bot-field" class="hidden" tabindex="-1" autocomplete="off" />
          <div class="grid md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label for="spd-name" class="font-body text-xs font-bold uppercase tracking-widest text-foreground">
                Nombre
              </label>
              <input
                type="text"
                id="spd-name"
                name="name"
                required
                placeholder="Tu nombre"
                class="w-full h-12 rounded-none border-2 border-foreground bg-background font-body text-sm px-4 focus:ring-0 focus:border-primary"
              />
            </div>
            <div class="space-y-2">
              <label for="spd-pharmacy" class="font-body text-xs font-bold uppercase tracking-widest text-foreground">
                Farmacia (opcional)
              </label>
              <input
                type="text"
                id="spd-pharmacy"
                name="pharmacy"
                placeholder="Nombre de tu farmacia"
                class="w-full h-12 rounded-none border-2 border-foreground bg-background font-body text-sm px-4 focus:ring-0 focus:border-primary"
              />
            </div>
          </div>

          <div class="space-y-2">
            <label for="spd-email" class="font-body text-xs font-bold uppercase tracking-widest text-foreground">
              Email
            </label>
            <input
              type="email"
              id="spd-email"
              name="email"
              required
              placeholder="tu@email.com"
              class="w-full h-12 rounded-none border-2 border-foreground bg-background font-body text-sm px-4 focus:ring-0 focus:border-primary"
            />
          </div>

          <div class="space-y-2">
            <label for="spd-message" class="font-body text-xs font-bold uppercase tracking-widest text-foreground">
              ¿Cómo haces SPD hoy? (opcional, pero ayuda mucho)
            </label>
            <textarea
              id="spd-message"
              name="message"
              rows="3"
              placeholder="Papel, Excel, plantillas propias..."
              class="w-full rounded-none border-2 border-foreground bg-background font-body text-sm px-4 py-3 focus:ring-0 focus:border-primary resize-none"
            ></textarea>
          </div>

          <div class="flex justify-center pt-4">
            <Button type="submit" variant="accent" size="xl" class="w-full md:w-auto">
              <Send class="w-5 h-5" />
              Enviar
            </Button>
          </div>
        </form>

        <div id="spd-form-success" class="hidden text-center py-8">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-accent mb-4">
            <Sparkles class="w-8 h-8 text-accent-foreground" />
          </div>
          <h3 class="font-display text-2xl font-bold text-foreground mb-2">
            ¡Mensaje enviado!
          </h3>
          <p class="text-muted-foreground">
            Te contesto en cuanto pueda.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('spd-contact-form') as HTMLFormElement;
  const successMessage = document.getElementById('spd-form-success');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    try {
      const res = await fetch(form.getAttribute('action') || '/contact.php', {
        method: 'POST',
        body: formData,
      });
      if (res.ok) {
        window.location.href = '/gracias';
      } else {
        const data = await res.json().catch(() => ({}));
        alert(data.error || 'Error al enviar. Escríbeme a abel@formulafarma.com');
      }
    } catch {
      alert('Error de conexión. Escríbeme a abel@formulafarma.com');
    }
  });
</script>
