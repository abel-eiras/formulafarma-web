---
import { Linkedin, Github, Mail } from 'lucide-astro';

const currentYear = new Date().getFullYear();

const socialLinks = [
  { icon: 'linkedin', href: 'https://www.linkedin.com/in/abel-eiras/', label: 'LinkedIn' },
  { icon: 'github', href: 'https://github.com/abel-eiras', label: 'GitHub' },
];

const products = [
  { label: 'Fórmula Care (el primero)', href: '/formula-care' },
  { label: 'SPD (el segundo, para Galicia)', href: '/spd' },
  { label: 'Más cosas (cuando duerma)', href: '#', disabled: true },
];

const legalLinks = [
  { label: 'Aviso Legal (aburrido pero necesario)', href: '/aviso-legal' },
  { label: 'Privacidad (no vendo tus datos)', href: '/privacidad' },
  { label: 'Cookies', href: '/cookies' },
];
---

<footer class="bg-foreground text-background border-t-4 border-primary py-16">
  <div class="container mx-auto px-4 lg:px-8">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <a href="/" class="flex items-center gap-3 mb-6">
          <img
            src="/logo_blanco.webp"
            alt="Fórmula Farma"
            class="w-12 h-12"
            width="48"
            height="48"
            loading="lazy"
            decoding="async"
          />
          <span class="font-display text-2xl font-bold uppercase tracking-tight">
            FormulaFarma
          </span>
        </a>
        <p class="text-background/60 max-w-md mb-6 font-body text-sm leading-relaxed">
          Un farmacéutico que aprendió a programar porque nadie le hacía
          el software que necesitaba. Así que lo hizo él mismo y lo soltó
          en abierto, gratis y con el código incluido.
        </p>
        
        <!-- Social Links -->
        <div class="flex items-center gap-3">
          {socialLinks.map((social) => (
            <a
              href={social.href}
              aria-label={social.label}
              class="w-10 h-10 border-2 border-background/30 flex items-center justify-center hover:bg-primary hover:border-primary transition-colors"
            >
              {social.icon === 'linkedin' && <Linkedin class="w-5 h-5" />}
              {social.icon === 'github' && <Github class="w-5 h-5" />}
            </a>
          ))}
        </div>
      </div>

      <!-- Products -->
      <div>
        <h4 class="font-display font-bold text-lg mb-4 uppercase">Inventos</h4>
        <ul class="space-y-3 text-background/60 font-body text-sm">
          {products.map((product) => (
            <li>
              {product.disabled ? (
                <span class="text-background/30">{product.label}</span>
              ) : (
                <a href={product.href} class="hover:text-accent transition-colors">
                  → {product.label}
                </a>
              )}
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="font-display font-bold text-lg mb-4 uppercase">Contacto</h4>
        <ul class="space-y-3 text-background/60 font-body text-sm">
          <li class="flex items-center gap-2">
            <Mail class="w-4 h-4 shrink-0" />
            <a href="mailto:abel@formulafarma.com" class="hover:text-accent transition-colors">abel@formulafarma.com</a>
          </li>
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-accent transition-colors">
                → {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t-2 border-background/10 pt-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <p class="text-background/40 text-xs font-body uppercase tracking-widest">
        © {currentYear} Fórmula Farma — Software libre, hecho con mucho café.
      </p>
      <p class="text-background/20 text-xs font-body">
        Código bajo licencia MIT. Sin trampa ni cartón.*
      </p>
    </div>
  </div>
</footer>
