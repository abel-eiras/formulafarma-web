---
import '../styles/global.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/merriweather/400.css';
import '@fontsource/merriweather/700.css';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
}

const { 
  title, 
  description = 'Blog personal sobre farmacia, tecnología y ciencia',
  image = 'https://formulafarma.com/logo.webp',
  type = 'website',
  publishedTime,
  modifiedTime,
  author = 'Abel Eiras Espiño'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://formulafarma.com');
const fullImageURL = image.startsWith('http') ? image : new URL(image, canonicalURL).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <meta name="generator" content={Astro.generator} />
    
    {/* Primary Meta Tags */}
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="canonical" href={canonicalURL} />
    
    {/* Open Graph / Facebook */}
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageURL} />
    <meta property="og:site_name" content="Fórmula Farma" />
    <meta property="og:locale" content="es_ES" />
    
    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageURL} />
    
    {/* Article specific meta tags */}
    {type === 'article' && publishedTime && (
      <>
        <meta property="article:published_time" content={publishedTime} />
        {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
        <meta property="article:author" content={author} />
      </>
    )}
  </head>
  <body class="bg-pharma-bg text-pharma-dark font-sans antialiased">
    <header class="border-b border-gray-200 bg-white">
      <nav class="container mx-auto px-4 py-4">
        <div class="flex items-center justify-between">
          <Logo />
          <div class="flex gap-6">
            <a href="/blog" class="text-pharma-grey hover:text-pharma-accent transition-colors">Blog</a>
            <a href="/sobre-mi" class="text-pharma-grey hover:text-pharma-accent transition-colors">Sobre mí</a>
            <a href="/contacto" class="text-pharma-grey hover:text-pharma-accent transition-colors">¿Hablamos?</a>
          </div>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-gray-200 bg-white mt-16">
      <div class="container mx-auto px-4 py-8">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-pharma-grey text-sm">
          <p>&copy; {new Date().getFullYear()} Fórmula Farma. Farmacéutico Híbrido.</p>
          <div class="flex gap-4">
            <a href="/aviso-legal" class="hover:text-pharma-accent transition-colors">Aviso Legal</a>
            <a href="/privacidad" class="hover:text-pharma-accent transition-colors">Privacidad</a>
            <a href="/cookies" class="hover:text-pharma-accent transition-colors">Cookies</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>

