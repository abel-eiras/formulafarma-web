---
import '../styles/global.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/merriweather/400.css';
import '@fontsource/merriweather/700.css';
import { ArrowUp } from 'lucide-astro';
import LanguagePicker from '../components/LanguagePicker.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  lang?: 'gl' | 'es';
}

const { 
  title, 
  description,
  image = 'https://formulafarma.com/logo.webp',
  type = 'website',
  publishedTime,
  modifiedTime,
  author = 'Abel Eiras Espiño',
  lang
} = Astro.props;

const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);

const defaultDescription = currentLang === 'gl' 
  ? 'Blog persoal sobre farmacia, tecnoloxía e ciencia'
  : 'Blog personal sobre farmacia, tecnología y ciencia';

const finalDescription = description || defaultDescription;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://formulafarma.com');
const fullImageURL = image.startsWith('http') ? image : new URL(image, canonicalURL).href;
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <meta name="generator" content={Astro.generator} />
    
    {/* Primary Meta Tags */}
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={finalDescription} />
    <meta name="author" content={author} />
    <link rel="canonical" href={canonicalURL} />
    
    {/* Open Graph / Facebook */}
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:image" content={fullImageURL} />
    <meta property="og:site_name" content="Fórmula Farma" />
    <meta property="og:locale" content={currentLang === 'gl' ? 'gl_ES' : 'es_ES'} />
    
    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={finalDescription} />
    <meta name="twitter:image" content={fullImageURL} />
    
    {/* Article specific meta tags */}
    {type === 'article' && publishedTime && (
      <>
        <meta property="article:published_time" content={publishedTime} />
        {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
        <meta property="article:author" content={author} />
      </>
    )}
    
    {/* Google Fonts - Brutalismo Maker */}
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&display=swap" rel="stylesheet" />
  </head>
  <body class="flex flex-col min-h-screen border-x-0 md:border-x-2 border-black max-w-7xl mx-auto">
    <style is:global>
      body {
        background-color: #f8f7f5;
        color: #1a1a1a;
        background-image: radial-gradient(#d1d1d1 1px, transparent 1px);
        background-size: 20px 20px;
      }
      /* Scrollbar Brutalista */
      ::-webkit-scrollbar { width: 10px; }
      ::-webkit-scrollbar-track { background: #f0f0f0; border-left: 2px solid #1a1a1a; }
      ::-webkit-scrollbar-thumb { background: #1a1a1a; }
      
      /* Clase de utilidad para cajas */
      .brutal-box {
        border: 2px solid #1a1a1a;
        box-shadow: 6px 6px 0px #1a1a1a;
        transition: all 0.2s ease;
        background-color: white;
      }
      .brutal-box:hover {
        transform: translate(-2px, -2px);
        box-shadow: 8px 8px 0px #1a1a1a;
      }
    </style>

    <!-- Top Bar / Navigation -->
    <header class="border-b-2 border-black bg-[#f8f7f5]">
        <div class="flex flex-col md:flex-row justify-between items-center p-4">
            <div class="flex items-center gap-2">
                <a href={translatePath('/')} class="flex items-center gap-2">
                    <div class="w-8 h-8 bg-black text-white flex items-center justify-center font-tech font-bold text-xl">F</div>
                    <h1 class="font-tech text-xl font-bold tracking-tighter uppercase">FormulaFarma<span class="text-xs ml-2 bg-yellow-300 px-1 border border-black text-black">By Abel Eiras</span></h1>
                </a>
            </div>
            <div class="flex items-center gap-4 mt-4 md:mt-0">
                <nav>
                    <ul class="flex space-x-6 font-tech text-sm font-bold uppercase">
                        <li><a href={`${translatePath('/blog/categoria/cultura-maker')}`} class="hover:bg-black hover:text-white px-2 py-1 transition-colors">{t('nav.maker')}</a></li>
                        <li><a href={`${translatePath('/blog/categoria/teatro-raices')}`} class="hover:bg-black hover:text-white px-2 py-1 transition-colors">{t('nav.scene')}</a></li>
                        <li><a href={`${translatePath('/blog/categoria/outras-merdas')}`} class="hover:bg-black hover:text-white px-2 py-1 transition-colors">{t('nav.opinion')}</a></li>
                        <li><a href={translatePath('/sobre-min')} class="hover:bg-black hover:text-white px-2 py-1 transition-colors">{t('nav.about')}</a></li>
                        <li><a href={translatePath('/contacto')} class="underline decoration-2 underline-offset-4">{t('nav.contact')}</a></li>
                    </ul>
                </nav>
                <LanguagePicker />
            </div>
        </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t-2 border-black bg-white mt-16">
      <div class="container mx-auto px-4 py-8">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4 font-tech text-sm">
          <p>&copy; {new Date().getFullYear()} {t('footer.copyright')}</p>
          <div class="flex gap-4">
            <a href={translatePath('/aviso-legal')} class="hover:bg-black hover:text-white px-2 py-1 transition-colors">{t('footer.legal')}</a>
            <a href={translatePath('/privacidad')} class="hover:bg-black hover:text-white px-2 py-1 transition-colors">{t('footer.privacy')}</a>
            <a href={translatePath('/cookies')} class="hover:bg-black hover:text-white px-2 py-1 transition-colors">{t('footer.cookies')}</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Botón Volver Arriba -->
    <button
      id="scroll-to-top"
      class="fixed bottom-8 right-8 w-12 h-12 bg-black text-white border-2 border-black rounded-full flex items-center justify-center shadow-brutal hover:shadow-brutal-hover transition-all opacity-0 pointer-events-none z-50"
      aria-label="Volver arriba"
    >
      <ArrowUp class="w-6 h-6" />
    </button>

    <script>
      (function() {
        const scrollButton = document.getElementById('scroll-to-top');
        if (!scrollButton) return;

        // Mostrar/ocultar botón según scroll
        function toggleScrollButton() {
          if (window.scrollY > 300) {
            scrollButton.classList.remove('opacity-0', 'pointer-events-none');
            scrollButton.classList.add('opacity-100');
          } else {
            scrollButton.classList.add('opacity-0', 'pointer-events-none');
            scrollButton.classList.remove('opacity-100');
          }
        }

        // Scroll suave hacia arriba
        scrollButton.addEventListener('click', () => {
          window.scrollTo({
            top: 0,
            behavior: 'smooth'
          });
        });

        // Escuchar eventos de scroll
        window.addEventListener('scroll', toggleScrollButton);
        
        // Verificar estado inicial
        toggleScrollButton();
      })();
    </script>
  </body>
</html>

