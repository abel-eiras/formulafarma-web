---
import Layout from '../layouts/Layout.astro';
import { Cpu, Drama, Bot } from 'lucide-astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Layout title="FormulaFarma | O Laboratorio de Abel Eiras" lang={lang}>
    <!-- Hero Section -->
    <section class="grid grid-cols-1 md:grid-cols-12 min-h-[60vh] border-b-2 border-black">
        <div class="md:col-span-7 p-8 md:p-16 flex flex-col justify-center border-b-2 md:border-b-0 md:border-r-2 border-black bg-white">
            <p class="font-tech text-sm text-gray-500 mb-4">&gt; init_personal_protocol.py</p>
            <h2 class="font-human text-5xl md:text-7xl font-black leading-[0.9] mb-6">
                {lang === 'gl' ? (
                    <>Non vendo <br />fórmulas. <br /><span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-700 to-indigo-600">Inventoas.</span></>
                ) : (
                    <>No vendo <br />fórmulas. <br /><span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-700 to-indigo-600">Las invento.</span></>
                )}
            </h2>
            <p class="font-tech text-base md:text-lg leading-relaxed text-gray-800 mb-8 border-l-4 border-yellow-400 pl-4">
                {t('hero.subtitle')}
            </p>
        </div>

        <div class="md:col-span-5 bg-blue-50 relative overflow-hidden flex items-center justify-center p-8">
            <div class="relative z-10 text-center">
                <div class="w-48 h-64 border-2 border-black bg-white mx-auto relative rotate-3 shadow-[8px_8px_0px_rgba(0,0,0,1)] flex flex-col items-center justify-center p-4">
                    <Bot class="w-16 h-16 mb-2 text-gray-800" />
                    <span class="font-tech text-xs font-bold mt-2">{t('hero.prototype')}</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Grid de Intereses -->
    <section class="p-8 md:p-12 bg-[#f8f7f5]">
        <div class="flex justify-between items-end mb-12 border-b-2 border-black pb-4">
            <h3 class="font-human text-4xl font-bold">{t('section.ingredients')}</h3>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Maker -->
            <a href={`${translatePath('/blog/categoria/cultura-maker')}`} id="maker" class="brutal-box p-6 flex flex-col h-full cursor-pointer">
                <Cpu class="w-12 h-12 mb-4" />
                <h4 class="font-human text-2xl font-bold mb-2">{t('maker.title')}</h4>
                <p class="font-tech text-xs text-gray-600">{t('maker.description')}</p>
            </a>
            <!-- Escena -->
            <a href={`${translatePath('/blog/categoria/teatro-raices')}`} id="escena" class="brutal-box p-6 flex flex-col h-full cursor-pointer">
                <Drama class="w-12 h-12 mb-4" />
                <h4 class="font-human text-2xl font-bold mb-2">{t('scene.title')}</h4>
                <p class="font-tech text-xs text-gray-600">{t('scene.description')}</p>
            </a>
            <!-- Outras merdas / Otras mierdas -->
            <a href={`${translatePath('/blog/categoria/outras-merdas')}`} id="otras-mierdas" class="brutal-box p-6 flex flex-col h-full cursor-pointer">
                <svg class="w-12 h-12 mb-4" fill="currentColor" stroke="none" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
                    <g transform="translate(0,512) scale(0.1,-0.1)">
                        <path d="M2568 5100 c-20 -11 -47 -36 -60 -57 -22 -37 -23 -45 -29 -338 -6 -328 -7 -339 -70 -437 -84 -130 -237 -207 -414 -208 -70 0 -199 -29 -270 -61 -158 -70 -303 -208 -378 -361 -75 -152 -103 -320 -74 -453 8 -38 18 -77 21 -85 5 -12 -10 -19 -71 -32 -333 -69 -586 -306 -674 -633 -17 -62 -22 -109 -22 -210 -1 -143 14 -221 62 -335 l28 -68 -41 -16 c-132 -51 -310 -193 -402 -323 -171 -239 -218 -566 -123 -845 93 -271 315 -493 584 -585 161 -55 99 -53 1925 -53 1826 0 1764 -2 1925 53 227 78 428 254 538 472 123 246 126 558 6 813 -93 200 -268 373 -462 457 l-64 28 24 56 c166 374 30 828 -316 1059 -123 83 -296 142 -413 142 -21 0 -38 5 -38 11 0 6 14 31 31 55 48 70 106 201 135 305 32 117 44 335 24 456 -51 322 -244 605 -527 775 -395 238 -693 413 -720 424 -44 19 -91 17 -135 -6z m509 -582 c331 -197 407 -266 494 -451 86 -186 93 -424 17 -617 -59 -150 -176 -290 -294 -355 -83 -46 -101 -61 -121 -99 -35 -67 -10 -158 55 -202 30 -20 46 -22 314 -27 310 -5 337 -9 453 -70 84 -45 182 -146 223 -231 102 -211 74 -420 -82 -610 -59 -72 -73 -111 -61 -173 9 -52 69 -110 120 -117 189 -29 295 -73 395 -163 214 -194 268 -480 139 -742 -80 -163 -244 -288 -424 -326 -105 -22 -3385 -22 -3490 0 -297 62 -512 343 -492 644 19 294 252 542 539 577 82 9 115 22 147 59 62 71 54 144 -25 241 -155 189 -184 400 -84 606 59 120 167 218 298 269 50 20 82 23 267 29 229 6 249 11 298 69 56 67 43 158 -30 218 -94 77 -122 111 -139 171 -14 47 -15 69 -7 129 20 136 92 250 205 324 69 44 146 64 293 77 190 16 333 78 466 200 174 161 249 339 249 595 0 76 4 127 10 127 5 0 125 -69 267 -152z"/>
                        <path d="M1643 2450 c-243 -49 -337 -353 -165 -534 119 -124 325 -129 447 -10 98 94 127 238 74 354 -48 103 -112 158 -216 185 -62 16 -78 17 -140 5z"/>
                        <path d="M3339 2447 c-61 -17 -131 -59 -165 -99 -81 -97 -102 -232 -52 -340 113 -245 449 -253 576 -13 23 43 27 62 27 140 0 75 -4 98 -24 139 -66 133 -227 210 -362 173z"/>
                        <path d="M1472 1473 c-77 -38 -101 -129 -62 -236 139 -385 453 -671 848 -774 120 -31 353 -43 482 -24 384 57 723 298 899 641 96 188 112 278 63 347 -47 67 20 63 -1144 63 -949 0 -1056 -2 -1086 -17z m1831 -334 c-30 -52 -152 -177 -219 -225 -76 -55 -206 -115 -299 -140 -100 -27 -351 -27 -450 0 -92 24 -199 74 -285 131 -70 47 -201 178 -233 234 l-18 31 761 0 761 0 -18 -31z"/>
                    </g>
                </svg>
                <h4 class="font-human text-2xl font-bold mb-2">{t('opinion.title')}</h4>
                <p class="font-tech text-xs text-gray-600">{t('opinion.description')}</p>
            </a>
        </div>
    </section>
</Layout>
