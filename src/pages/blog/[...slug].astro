---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import RatingCapsules from '../../components/RatingCapsules.astro';
import Comments from '../../components/Comments.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  
  // Generar rutas: para gallego (/) y español (/es/)
  const paths = [];
  const slugMap = new Map<string, { gl?: typeof allPosts[0], es?: typeof allPosts[0] }>();
  
  // Agrupar posts por translationSlug o slug
  for (const post of allPosts) {
    const postLang = post.data.lang || 'gl';
    const urlSlug = post.data.translationSlug || post.slug;
    
    if (!slugMap.has(urlSlug)) {
      slugMap.set(urlSlug, {});
    }
    const entry = slugMap.get(urlSlug)!;
    entry[postLang] = post;
  }
  
  // Generar rutas para cada slug (en ambos idiomas si existen)
  for (const [urlSlug, posts] of slugMap.entries()) {
    // Ruta en gallego (si existe el post en gallego o no hay post en español)
    if (posts.gl) {
      paths.push({
        params: { slug: urlSlug },
        props: { post: posts.gl, lang: 'gl' },
      });
    }
    
    // Ruta en español (si existe el post en español)
    if (posts.es) {
      paths.push({
        params: { slug: urlSlug },
        props: { post: posts.es, lang: 'es' },
      });
    }
  }
  
  return paths;
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post, lang: postLang } = Astro.props;
const { Content } = await post.render();

const lang = postLang || getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Obtener slug de la URL para construir rutas correctas
const urlSlug = Astro.params.slug || '';
const urlLang = getLangFromUrl(Astro.url);

const formattedDate = new Intl.DateTimeFormat(lang === 'gl' ? 'gl-ES' : 'es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(post.data.date);

// URLs para SEO - usar el slug de la URL actual
const postURLSlug = post.data.translationSlug || post.slug;
const postURL = new URL(lang === 'gl' ? `/blog/${postURLSlug}` : `/es/blog/${postURLSlug}`, Astro.site || 'https://formulafarma.com').href;
const postImage = post.data.image 
  ? (post.data.image.startsWith('http') ? post.data.image : new URL(post.data.image, Astro.site || 'https://formulafarma.com').href)
  : new URL('/logo.webp', Astro.site || 'https://formulafarma.com').href;

// Obtener posts para navegación (del mismo idioma)
const allPosts = await getCollection('blog');
const visiblePosts = allPosts.filter(p => {
  const postLang = p.data.lang || 'gl';
  return postLang === lang;
});
const sortedPosts = visiblePosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const currentIndex = sortedPosts.findIndex((p) => p.slug === post.slug);
const previousPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;
const nextPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;
---

<Layout 
  title={`${post.data.title} - Fórmula Farma`} 
  description={post.data.excerpt || post.data.title}
  image={postImage}
  type="article"
  publishedTime={post.data.date.toISOString()}
  modifiedTime={post.data.date.toISOString()}
>
  <article class="container mx-auto px-4 py-12">
    <div class="max-w-4xl mx-auto">
      {/* Botón volver y selector de idioma */}
      <div class="flex items-center justify-between mb-8">
        <a href={lang === 'gl' ? '/blog' : '/es/blog'} class="inline-flex items-center text-pharma-accent hover:text-pharma-dark transition-colors">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          {lang === 'gl' ? 'Volver ao blog' : 'Volver al blog'}
        </a>
        
        {/* Enlace a la traducción si existe */}
        {post.data.translationSlug && (
          <a 
            href={lang === 'gl' ? `/es/blog/${post.data.translationSlug}` : `/blog/${post.data.translationSlug}`}
            class="text-sm text-pharma-accent hover:text-pharma-dark transition-colors underline"
          >
            {lang === 'gl' ? 'Versión en español' : 'Versión en galego'}
          </a>
        )}
      </div>

      {/* Header del post */}
      <header class="mb-8">
        <div class="flex items-center gap-2 text-sm text-pharma-grey mb-4">
          <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
          {post.data.tags && post.data.tags.length > 0 && (
            <>
              <span class="text-pharma-grey">•</span>
              <span class="text-xs text-pharma-grey">
                {post.data.tags.slice(0, 3).join(', ')}{post.data.tags.length > 3 ? ` +${post.data.tags.length - 3} más` : ''}
              </span>
            </>
          )}
        </div>

        <h1 class="text-4xl md:text-5xl font-bold text-pharma-dark mb-4">
          {post.data.title}
        </h1>

        {post.data.excerpt && (
          <p class="text-xl text-pharma-grey leading-relaxed">
            {post.data.excerpt}
          </p>
        )}
      </header>

      {/* Imagen destacada */}
      {post.data.image && (
        <div class="mb-8 rounded-lg overflow-hidden">
          <img 
            src={post.data.image} 
            alt={post.data.title}
            width="1200"
            height="630"
            loading="eager"
            decoding="async"
            class="w-full h-auto object-cover"
          />
        </div>
      )}

      {/* Structured Data (JSON-LD) */}
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": post.data.title,
        "description": post.data.excerpt || post.data.title,
        "image": postImage,
        "datePublished": post.data.date.toISOString(),
        "dateModified": post.data.date.toISOString(),
        "author": {
          "@type": "Person",
          "name": "Abel Eiras Espiño",
          "url": "https://formulafarma.com/sobre-min"
        },
        "publisher": {
          "@type": "Person",
          "name": "Abel Eiras Espiño",
          "logo": {
            "@type": "ImageObject",
            "url": "https://formulafarma.com/logo.webp"
          }
        },
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": postURL
        }
      })} />

      {/* Contenido del post */}
      <div class="prose prose-lg prose-slate max-w-none font-serif">
        <Content />
      </div>

      {/* Sistema de valoración */}
      <RatingCapsules postSlug={post.slug} />

      {/* Sistema de comentarios */}
      <Comments postSlug={post.slug} lang={lang} />

      {/* Navegación entre posts */}
      {(previousPost || nextPost) && (
        <nav class="mt-16 pt-8 border-t border-gray-200">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {previousPost && (
              <a 
                href={lang === 'gl' ? `/blog/${previousPost.data.translationSlug || previousPost.slug}` : `/es/blog/${previousPost.data.translationSlug || previousPost.slug}`}
                class="group p-4 border border-gray-200 rounded-lg hover:border-pharma-accent transition-colors"
              >
                <div class="text-sm text-pharma-grey mb-2">{lang === 'gl' ? '← Post anterior' : '← Post anterior'}</div>
                <div class="font-semibold text-pharma-dark group-hover:text-pharma-accent transition-colors">
                  {previousPost.data.title}
                </div>
              </a>
            )}
            {nextPost && (
              <a 
                href={lang === 'gl' ? `/blog/${nextPost.data.translationSlug || nextPost.slug}` : `/es/blog/${nextPost.data.translationSlug || nextPost.slug}`}
                class="group p-4 border border-gray-200 rounded-lg hover:border-pharma-accent transition-colors text-right md:text-left"
              >
                <div class="text-sm text-pharma-grey mb-2">{lang === 'gl' ? 'Post seguinte →' : 'Post siguiente →'}</div>
                <div class="font-semibold text-pharma-dark group-hover:text-pharma-accent transition-colors">
                  {nextPost.data.title}
                </div>
              </a>
            )}
          </div>
        </nav>
      )}
    </div>
  </article>
</Layout>

