---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout 
  title="Blog - Fórmula Farma" 
  description="Todos los posts del blog de Fórmula Farma sobre farmacia, tecnología y ciencia. Explorando la intersección entre la salud y la innovación."
>
  <div class="container mx-auto px-4 py-12">
    <div class="max-w-6xl mx-auto">
      <header class="mb-12 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-pharma-dark mb-4">
          Blog
        </h1>
        <p class="text-xl text-pharma-grey max-w-2xl mx-auto">
          Explorando la intersección entre farmacia, tecnología y comunicación
        </p>
      </header>

      {posts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map((post) => (
            <PostCard
              title={post.data.title}
              date={post.data.date}
              excerpt={post.data.excerpt}
              tags={post.data.tags}
              slug={post.slug}
              image={post.data.image}
            />
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <p class="text-pharma-grey text-lg">No hay posts disponibles aún.</p>
        </div>
      )}
    </div>
  </div>
</Layout>

