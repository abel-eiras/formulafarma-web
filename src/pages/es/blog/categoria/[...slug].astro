---
import Layout from '../../../../layouts/Layout.astro';
import PostCard from '../../../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../../../i18n/utils';

export async function getStaticPaths() {
  // Mapeo de slugs a nombres de categorías
  const categoryMap: Record<string, string> = {
    'cultura-maker': 'Cultura Maker',
    'teatro-raices': 'Teatro & Raíces',
    'outras-merdas': 'Outras merdas',
  };
  const categories = Object.keys(categoryMap);
  return categories.map((slug) => ({
    params: { slug },
  }));
}

const lang = 'es'; // Siempre español en esta ruta
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Mapeo de slugs a nombres de categorías
const categoryMap: Record<string, string> = {
  'cultura-maker': 'Cultura Maker',
  'teatro-raices': 'Teatro & Raíces',
  'outras-merdas': 'Outras merdas',
};

const { slug } = Astro.params;
const categoryName = slug ? categoryMap[slug] : null;

if (!categoryName) {
  return Astro.redirect('/es/blog');
}

const allPosts = await getCollection('blog');
// Filtrar posts de la categoría específica y del idioma correspondiente
const posts = allPosts
  .filter(post => {
    const hasCategory = post.data.category === categoryName;
    const postLang = post.data.lang || 'gl';
    return hasCategory && postLang === lang;
  })
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Títulos de categorías
const categoryTitles: Record<string, Record<'gl' | 'es', string>> = {
  'Cultura Maker': {
    gl: 'Cultura Maker',
    es: 'Cultura Maker',
  },
  'Teatro & Raíces': {
    gl: 'Teatro & Raíces',
    es: 'Teatro & Raíces',
  },
  'Outras merdas': {
    gl: 'Outras merdas',
    es: 'Otras mierdas',
  },
};

const categoryTitle = categoryTitles[categoryName]?.[lang] || categoryName;
---

<Layout 
  title={`${categoryTitle} - Blog - Fórmula Farma`}
  description={`Posts de la categoría ${categoryTitle} del blog de Fórmula Farma`}
  lang={lang}
>
  <div class="container mx-auto px-4 py-12">
    <div class="max-w-6xl mx-auto">
      <header class="mb-12 text-center">
        <a href="/es/blog" class="inline-flex items-center text-pharma-accent hover:text-pharma-dark transition-colors mb-8">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Volver al blog
        </a>
        <h1 class="text-4xl md:text-5xl font-bold mb-4">
          {categoryTitle}
        </h1>
        <p class="text-xl max-w-2xl mx-auto text-pharma-grey">
          {posts.length === 0 
            ? 'Aún no hay publicaciones en esta categoría.'
            : `${posts.length} publicación${posts.length === 1 ? '' : 'es'}`
          }
        </p>
      </header>

      {posts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map((post) => (
            <PostCard
              title={post.data.title}
              date={post.data.date}
              excerpt={post.data.excerpt}
              tags={post.data.tags}
              slug={post.data.translationSlug || post.slug}
              image={post.data.image}
              lang={lang}
            />
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <p class="text-lg text-pharma-grey">
            No hay posts disponibles en esta categoría aún.
          </p>
        </div>
      )}
    </div>
  </div>
</Layout>


