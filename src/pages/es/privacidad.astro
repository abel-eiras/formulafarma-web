---

<Layout title={lang === 'gl' ? 'Política de Privacidade - Fórmula Farma' : 'Política de Privacidad - Fórmula Farma'} description={lang === 'gl' ? 'Política de privacidade de Fórmula Farma' : 'Política de privacidad de Fórmula Farma'} lang={lang}>
  <div class="container mx-auto px-4 py-12 max-w-4xl">
    <article class="brutal-box p-8 bg-white my-8 prose font-human" set:html={lang === 'gl' ? contentGl : contentEs} />
  </div>
</Layout>
