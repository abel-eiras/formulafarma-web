---
import Layout from '../layouts/Layout.astro';
import SocialIcons from '../components/SocialIcons.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Layout title={lang === 'gl' ? 'Falamos? - Fórmula Farma' : '¿Hablamos? - Fórmula Farma'} description={lang === 'gl' ? 'Páxina de contacto de Fórmula Farma. Envíame unha mensaxe ou conéctate comigo en redes sociais' : 'Página de contacto de Fórmula Farma. Envíame un mensaje o conéctate conmigo en redes sociales'} lang={lang}>
  <div class="container mx-auto px-4 py-12 max-w-4xl">
    <div class="prose prose-lg prose-slate max-w-none font-human mb-12">
      <h1 class="text-4xl font-bold mb-4">{t('contact.title')}</h1>
      <p class="text-xl mb-6">
        {t('contact.subtitle1')}
      </p>
      <p>
        {t('contact.subtitle2')}
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-12">
      {/* Formulario de contacto */}
      <div class="brutal-box p-8 bg-white">
        <h2 class="text-2xl font-semibold mb-6 font-human">{t('contact.form.title')}</h2>
        <div id="form-message" class="hidden mb-4 p-4"></div>
        <form 
          id="contact-form"
          name="contact" 
          method="POST" 
          action="/contact.php"
          class="space-y-6"
        >
          {/* Honeypot para protección anti-spam */}
          <p class="hidden">
            <label>
              {lang === 'gl' ? 'Non enchas este campo se es humano:' : 'No llenes este campo si eres humano:'} <input name="bot-field" tabindex="-1" autocomplete="off" />
            </label>
          </p>
          
          <div>
            <label for="name" class="block text-sm font-medium mb-2 font-tech">
              {t('contact.form.name')}
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full border-2 border-black p-3 font-tech text-sm focus:outline-none focus:bg-yellow-50 mb-4"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-medium mb-2 font-tech">
              {t('contact.form.email')}
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full border-2 border-black p-3 font-tech text-sm focus:outline-none focus:bg-yellow-50 mb-4"
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-medium mb-2 font-tech">
              {t('contact.form.message')}
            </label>
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              class="w-full border-2 border-black p-3 font-tech text-sm focus:outline-none focus:bg-yellow-50 mb-4"
            ></textarea>
          </div>

          <div class="flex items-start">
            <input
              type="checkbox"
              id="privacy-consent"
              name="privacy-consent"
              required
              class="mt-1 h-4 w-4 border-2 border-black"
            />
            <label for="privacy-consent" class="ml-3 text-sm font-tech">
              {t('contact.form.consent')} 
              <a href={translatePath('/privacidad')} class="underline decoration-2 underline-offset-4" target="_blank" rel="noopener noreferrer">
                {t('contact.form.privacy')}
              </a>
              <span class="text-red-500">*</span>
            </label>
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="bg-black text-white font-tech font-bold uppercase py-3 px-6 hover:bg-gray-800 transition-colors cursor-pointer border-2 border-transparent hover:border-black w-full disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <span id="submit-text">{t('contact.form.submit')}</span>
            <span id="submit-loading" class="hidden">{t('contact.form.sending')}</span>
          </button>
        </form>
      </div>

      <script define:vars={{ lang, t }}>
        document.getElementById('contact-form').addEventListener('submit', async function(e) {
          e.preventDefault();
          
          const form = e.target;
          const submitBtn = document.getElementById('submit-btn');
          const submitText = document.getElementById('submit-text');
          const submitLoading = document.getElementById('submit-loading');
          const messageDiv = document.getElementById('form-message');
          
          // Deshabilitar botón y mostrar loading
          submitBtn.disabled = true;
          submitText.classList.add('hidden');
          submitLoading.classList.remove('hidden');
          messageDiv.classList.add('hidden');
          
          // Preparar datos del formulario
          const formData = new FormData(form);
          
          try {
            const response = await fetch('/contact.php', {
              method: 'POST',
              body: formData
            });
            
            const data = await response.json();
            
            if (response.ok && data.success) {
              // Éxito
              messageDiv.className = 'mb-4 p-4 border-2 border-black bg-green-50 text-green-800 font-tech';
              messageDiv.textContent = data.message || (lang === 'gl' ? '¡Mensaxe enviada correctamente! Respondereiche pronto.' : '¡Mensaje enviado correctamente! Te responderé pronto.');
              messageDiv.classList.remove('hidden');
              form.reset();
            } else {
              // Error
              messageDiv.className = 'mb-4 p-4 border-2 border-black bg-red-50 text-red-800 font-tech';
              messageDiv.textContent = data.error || (lang === 'gl' ? 'Erro ao enviar a mensaxe. Por favor, intenta de novo.' : 'Error al enviar el mensaje. Por favor, intenta de nuevo.');
              messageDiv.classList.remove('hidden');
            }
          } catch (error) {
            // Error de red
            messageDiv.className = 'mb-4 p-4 border-2 border-black bg-red-50 text-red-800 font-tech';
            messageDiv.textContent = lang === 'gl' ? 'Erro de conexión. Por favor, verifica a túa conexión e intenta de novo.' : 'Error de conexión. Por favor, verifica tu conexión e intenta de nuevo.';
            messageDiv.classList.remove('hidden');
          } finally {
            // Rehabilitar botón
            submitBtn.disabled = false;
            submitText.classList.remove('hidden');
            submitLoading.classList.add('hidden');
          }
        });
      </script>

      {/* Redes sociales */}
      <div class="brutal-box p-8 bg-white">
        <h2 class="text-2xl font-semibold mb-6 font-human">{t('contact.social.title')}</h2>
        <p class="mb-6 font-tech">
          {t('contact.social.text')}
        </p>
        <SocialIcons />
      </div>
    </div>
  </div>
</Layout>
